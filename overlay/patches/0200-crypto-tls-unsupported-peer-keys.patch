+func TestVerifyUnsupportedSignatureServerCertificate(t *testing.T) {
+	skipFIPS(t) // Hooks are off in FIPS 140-3 mode; see TestVerifyUnsupportedSignatureFIPS.
+	cert, pool := unsupportedKeyCertificate(t, "server.example")
+	for _, tt := range unsupportedKeyTests() {
+		t.Run(tt.name, func(t *testing.T) {
+			var hookRuns int
+			var gotScheme SignatureScheme
+			clientConfig := testConfigClient.Clone()
+			clientConfig.MinVersion = tt.version
+			clientConfig.MaxVersion = tt.version
+			clientConfig.InsecureSkipVerify = true
+			clientConfig.VerifyConnection = func(cs ConnectionState) error {
+				// The certificate chain is verified as usual.
+				opts := x509.VerifyOptions{Roots: pool, CurrentTime: testTime()}
+				_, err := cs.PeerCertificates[0].Verify(opts)
+				if err == nil || !strings.Contains(err.Error(), "unsupported elliptic curve") {
+					t.Errorf("Verify: err = %v, want an unsupported curve error", err)
+				}
+				return nil
+			}
+			if tt.hook != nil {
+				clientConfig.VerifyUnsupportedSignature = func(leaf *x509.Certificate, scheme SignatureScheme, signed, sig []byte) error {
+					hookRuns++
+					gotScheme = scheme
+					if leaf.Subject.CommonName != "server.example" {
+						t.Errorf("leaf.Subject.CommonName = %q", leaf.Subject.CommonName)
+					}
+					return tt.hook(leaf, scheme, signed, sig)
+				}
+			}
+			serverConfig := testConfigServer.Clone()
+			serverConfig.Certificates = []Certificate{cert}
+			serverConfig.MaxVersion = tt.version
+
+			clientErr, serverErr := fipsHandshake(t, clientConfig, serverConfig)
+			switch {
+			case tt.name == "hook":
+				if clientErr != nil || serverErr != nil {
+					t.Fatalf("handshake failed: client: %v, server: %v", clientErr, serverErr)
+				}
+				if gotScheme != ECDSAWithP256AndSHA256 {
+					t.Errorf("scheme = %v, want %v", gotScheme, ECDSAWithP256AndSHA256)
+				}
+			case tt.name == "hook fails":
+				if clientErr == nil || !errors.Is(clientErr, errTestHook) && !strings.Contains(clientErr.Error(), errTestHook.Error()) {
+					t.Errorf("client error = %v, want %v", clientErr, errTestHook)
+				}
+				if serverErr == nil || !strings.Contains(serverErr.Error(), "illegal parameter") {
+					t.Errorf("server error = %v, want an illegal_parameter alert", serverErr)
+				}
+			case tt.name == "TLS 1.3 implemented scheme":
+				if clientErr == nil || !strings.Contains(clientErr.Error(), "invalid signature algorithm") {
+					t.Errorf("client error = %v, want an invalid signature algorithm error", clientErr)
+				}
+				if serverErr == nil || !strings.Contains(serverErr.Error(), "illegal parameter") {
+					t.Errorf("server error = %v, want an illegal_parameter alert", serverErr)
+				}
+			default:
+				if clientErr == nil || !strings.Contains(clientErr.Error(), "unsupported type of public key") {
+					t.Errorf("client error = %v, want an unsupported public key error", clientErr)
+				}
+				if serverErr == nil || !strings.Contains(serverErr.Error(), "unsupported certificate") {
+					t.Errorf("server error = %v, want an unsupported_certificate alert", serverErr)
+				}
+			}
+			if wantRuns := map[bool]int{true: 1, false: 0}[tt.wantHookRun]; hookRuns != wantRuns {
+				t.Errorf("hook ran %d times, want %d", hookRuns, wantRuns)
+			}
+		})
+	}
+}
