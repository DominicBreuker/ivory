+func TestVerifyUnsupportedSignatureClientCertificate(t *testing.T) {
+	skipFIPS(t) // Hooks are off in FIPS 140-3 mode; see TestVerifyUnsupportedSignatureFIPS.
+	cert, pool := unsupportedKeyCertificate(t, "client.example")
+	for _, tt := range unsupportedKeyTests() {
+		t.Run(tt.name, func(t *testing.T) {
+			var hookRuns int
+			var gotScheme SignatureScheme
+			serverConfig := testConfigServer.Clone()
+			serverConfig.MaxVersion = tt.version
+			serverConfig.ClientAuth = RequireAnyClientCert
+			serverConfig.ClientCAs = pool // sent as the acceptable CAs
+			serverConfig.VerifyConnection = func(cs ConnectionState) error {
+				opts := x509.VerifyOptions{Roots: pool, CurrentTime: testTime(), KeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth}}
+				if _, err := cs.PeerCertificates[0].Verify(opts); err == nil {
+					t.Error("Verify succeeded for a certificate with an unsupported key")
+				}
+				return nil
+			}
+			if tt.hook != nil {
+				serverConfig.VerifyUnsupportedSignature = func(leaf *x509.Certificate, scheme SignatureScheme, signed, sig []byte) error {
+					hookRuns++
+					gotScheme = scheme
+					return tt.hook(leaf, scheme, signed, sig)
+				}
+			}
+			clientConfig := testConfigClient.Clone()
+			clientConfig.MinVersion = tt.version
+			clientConfig.MaxVersion = tt.version
+			clientConfig.Certificates = []Certificate{cert}
+
+			clientErr, serverErr := fipsHandshake(t, clientConfig, serverConfig)
+			switch {
+			case tt.name == "hook":
+				if clientErr != nil || serverErr != nil {
+					t.Fatalf("handshake failed: client: %v, server: %v", clientErr, serverErr)
+				}
+				if gotScheme != ECDSAWithP256AndSHA256 {
+					t.Errorf("scheme = %v, want %v", gotScheme, ECDSAWithP256AndSHA256)
+				}
+			case tt.name == "hook fails":
+				if serverErr == nil || !strings.Contains(serverErr.Error(), errTestHook.Error()) {
+					t.Errorf("server error = %v, want %v", serverErr, errTestHook)
+				}
+				if clientErr == nil || !strings.Contains(clientErr.Error(), "error decrypting message") {
+					t.Errorf("client error = %v, want a decrypt_error alert", clientErr)
+				}
+			case tt.name == "TLS 1.3 implemented scheme":
+				// The client learns about the alert only after its handshake.
+				if serverErr == nil || !strings.Contains(serverErr.Error(), "invalid signature algorithm") {
+					t.Errorf("server error = %v, want an invalid signature algorithm error", serverErr)
+				}
+			case tt.version == VersionTLS13:
+				if serverErr == nil || !strings.Contains(serverErr.Error(), "unsupported public key") {
+					t.Errorf("server error = %v, want an unsupported public key error", serverErr)
+				}
+			default:
+				if serverErr == nil || !strings.Contains(serverErr.Error(), "unsupported public key") {
+					t.Errorf("server error = %v, want an unsupported public key error", serverErr)
+				}
+				if clientErr == nil || !strings.Contains(clientErr.Error(), "unsupported certificate") {
+					t.Errorf("client error = %v, want an unsupported_certificate alert", clientErr)
+				}
+			}
+			if wantRuns := map[bool]int{true: 1, false: 0}[tt.wantHookRun]; hookRuns != wantRuns {
+				t.Errorf("hook ran %d times, want %d", hookRuns, wantRuns)
+			}
+		})
+	}
+}
