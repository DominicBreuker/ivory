+// TestVerifyUnsupportedSignatureServerKeyExchangeScheme checks that the
+// signature scheme of a ServerKeyExchange by a server with an unsupported key
+// is checked before the hook is called: it must be one the client advertised,
+// and its signature algorithm must match the cipher suite.
+func TestVerifyUnsupportedSignatureServerKeyExchangeScheme(t *testing.T) {
+	skipFIPS(t) // Hooks are off in FIPS 140-3 mode; see TestVerifyUnsupportedSignatureFIPS.
+	cert, _ := unsupportedKeyCertificate(t, "server.example")
+	rsaCert := Certificate{Certificate: cert.Certificate, PrivateKey: testRSA2048Cert.PrivateKey}
+	const notAdvertised SignatureScheme = 0xfe01 // private use (RFC 8446)
+	for _, tt := range []struct {
+		name      string
+		cert      Certificate
+		suite     uint16
+		scheme    SignatureScheme // replaces the server's scheme; 0 keeps it
+		clientErr string
+	}{
+		{"ECDSA suite and scheme", cert, TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, 0, ""},
+		{"not advertised", cert, TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, notAdvertised, "invalid signature algorithm"},
+		{"RSA scheme on an ECDSA suite", cert, TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, PKCS1WithSHA256, "invalid ServerKeyExchange"},
+		{"RSA-PSS scheme on an ECDSA suite", cert, TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, PSSWithSHA256, "invalid ServerKeyExchange"},
+		{"ECDSA scheme on an RSA suite", rsaCert, TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, ECDSAWithP256AndSHA256, "invalid ServerKeyExchange"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			var hookRuns int
+			clientConfig := testConfigClient.Clone()
+			clientConfig.MaxVersion = VersionTLS12
+			clientConfig.CipherSuites = []uint16{tt.suite}
+			clientConfig.InsecureSkipVerify = true
+			clientConfig.VerifyUnsupportedSignature = func(leaf *x509.Certificate, scheme SignatureScheme, signed, sig []byte) error {
+				hookRuns++
+				return verifyUnsupportedCurveSignature(leaf, scheme, signed, sig)
+			}
+			serverConfig := testConfigServer.Clone()
+			serverConfig.Certificates = []Certificate{tt.cert}
+
+			clientErr, serverErr := handshakeWithRewrite(t, clientConfig, serverConfig, false, typeServerKeyExchange, func(msg []byte) {
+				if tt.scheme == 0 {
+					return
+				}
+				// ECParameters (curve_type, named_curve, public key), then
+				// the signature scheme.
+				i := 4 + int(msg[3])
+				msg[i], msg[i+1] = byte(tt.scheme>>8), byte(tt.scheme)
+			})
+			if tt.clientErr == "" {
+				if clientErr != nil || serverErr != nil {
+					t.Fatalf("handshake failed: client: %v, server: %v", clientErr, serverErr)
+				}
+				if hookRuns != 1 {
+					t.Errorf("hook ran %d times, want 1", hookRuns)
+				}
+				return
+			}
+			if clientErr == nil || !strings.Contains(clientErr.Error(), tt.clientErr) {
+				t.Errorf("client error = %v, want %q", clientErr, tt.clientErr)
+			}
+			if serverErr == nil || !strings.Contains(serverErr.Error(), "illegal parameter") {
+				t.Errorf("server error = %v, want an illegal_parameter alert", serverErr)
+			}
+			if hookRuns != 0 {
+				t.Errorf("hook ran %d times, want 0", hookRuns)
+			}
+		})
+	}
+}
