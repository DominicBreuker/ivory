+// rewriteHandshakeConn is a net.Conn that lets a test change the handshake
+// messages of one type that it writes, as an attacker could. This package
+// writes each handshake message in its own records, and the messages before
+// ChangeCipherSpec in TLS 1.2 are not encrypted.
+type rewriteHandshakeConn struct {
+	net.Conn
+	typ     uint8
+	rewrite func(msg []byte) // the message body, after the 4-byte header
+}
+
+func (c *rewriteHandshakeConn) Write(b []byte) (int, error) {
+	out := slices.Clone(b)
+	for rec := out; len(rec) > recordHeaderLen; {
+		n := recordHeaderLen + (int(rec[3])<<8 | int(rec[4]))
+		if n > len(rec) {
+			break
+		}
+		if recordType(rec[0]) == recordTypeHandshake && rec[recordHeaderLen] == c.typ {
+			c.rewrite(rec[recordHeaderLen+4 : n])
+		}
+		rec = rec[n:]
+	}
+	if _, err := c.Conn.Write(out); err != nil {
+		return 0, err
+	}
+	return len(b), nil
+}
+
+// handshakeWithRewrite runs a handshake in which the handshake messages of
+// type typ, written by the server (or the client if fromClient is set), are
+// changed by rewrite.
+func handshakeWithRewrite(t *testing.T, clientConfig, serverConfig *Config, fromClient bool, typ uint8, rewrite func([]byte)) (clientErr, serverErr error) {
+	c, s := localPipe(t)
+	var cc, sc net.Conn = c, s
+	if fromClient {
+		cc = &rewriteHandshakeConn{Conn: c, typ: typ, rewrite: rewrite}
+	} else {
+		sc = &rewriteHandshakeConn{Conn: s, typ: typ, rewrite: rewrite}
+	}
+	done := make(chan error, 1)
+	go func() {
+		done <- Client(cc, clientConfig).Handshake()
+		c.Close()
+	}()
+	serverErr = Server(sc, serverConfig).Handshake()
+	s.Close()
+	clientErr = <-done
+	return
+}
