+// TestVerifyUnsupportedSignatureCertificateVerifyScheme checks that the
+// signature scheme of a CertificateVerify by a client with an unsupported key
+// must be one the server advertised before the hook is called. Whether the
+// scheme fits the key is for the hook to check.
+func TestVerifyUnsupportedSignatureCertificateVerifyScheme(t *testing.T) {
+	skipFIPS(t) // Hooks are off in FIPS 140-3 mode; see TestVerifyUnsupportedSignatureFIPS.
+	cert, pool := unsupportedKeyCertificate(t, "client.example")
+	const notAdvertised SignatureScheme = 0xfe01 // private use (RFC 8446)
+	for _, tt := range []struct {
+		name        string
+		scheme      SignatureScheme // replaces the client's scheme; 0 keeps it
+		serverErr   string
+		wantHookRun bool
+	}{
+		{"ECDSA scheme", 0, "", true},
+		{"not advertised", notAdvertised, "invalid signature algorithm", false},
+		{"RSA scheme", PKCS1WithSHA256, "unsupported signature scheme", true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			var hookRuns int
+			var gotScheme SignatureScheme
+			serverConfig := testConfigServer.Clone()
+			serverConfig.MaxVersion = VersionTLS12
+			serverConfig.ClientAuth = RequireAnyClientCert
+			serverConfig.ClientCAs = pool // sent as the acceptable CAs
+			serverConfig.VerifyUnsupportedSignature = func(leaf *x509.Certificate, scheme SignatureScheme, signed, sig []byte) error {
+				hookRuns++
+				gotScheme = scheme
+				return verifyUnsupportedCurveSignature(leaf, scheme, signed, sig)
+			}
+			clientConfig := testConfigClient.Clone()
+			clientConfig.Certificates = []Certificate{cert}
+
+			clientErr, serverErr := handshakeWithRewrite(t, clientConfig, serverConfig, true, typeCertificateVerify, func(msg []byte) {
+				if tt.scheme != 0 {
+					msg[0], msg[1] = byte(tt.scheme>>8), byte(tt.scheme)
+				}
+			})
+			if wantRuns := map[bool]int{true: 1, false: 0}[tt.wantHookRun]; hookRuns != wantRuns {
+				t.Errorf("hook ran %d times, want %d", hookRuns, wantRuns)
+			}
+			if tt.serverErr == "" {
+				if clientErr != nil || serverErr != nil {
+					t.Fatalf("handshake failed: client: %v, server: %v", clientErr, serverErr)
+				}
+				return
+			}
+			if serverErr == nil || !strings.Contains(serverErr.Error(), tt.serverErr) {
+				t.Errorf("server error = %v, want %q", serverErr, tt.serverErr)
+			}
+			wantAlert := "error decrypting message" // decrypt_error
+			if !tt.wantHookRun {
+				wantAlert = "illegal parameter"
+			} else if gotScheme != tt.scheme {
+				t.Errorf("hook got scheme %v, want %v", gotScheme, tt.scheme)
+			}
+			if clientErr == nil || !strings.Contains(clientErr.Error(), wantAlert) {
+				t.Errorf("client error = %v, want %q", clientErr, wantAlert)
+			}
+		})
+	}
+}
