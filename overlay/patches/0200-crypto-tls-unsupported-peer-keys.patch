+// verifyPeerHandshakeSignature verifies a TLS 1.2 or TLS 1.3 handshake
+// signature made by the peer's leaf certificate. If this package doesn't
+// support its public key, it calls Config.VerifyUnsupportedSignature.
+func verifyPeerHandshakeSignature(config *Config, vers uint16, leaf *x509.Certificate, scheme SignatureScheme, sigType uint8, hashFunc crypto.Hash, signed, sig []byte) error {
+	if leaf.PublicKey == nil {
+		if !config.supportsUnsupportedPeerKey(vers) {
+			return errors.New("unsupported public key")
+		}
+		return config.VerifyUnsupportedSignature(leaf, scheme, signed, sig)
+	}
+	return verifyHandshakeSignature(sigType, leaf.PublicKey, hashFunc, signed, sig)
+}
+
+// isPeerSignatureSchemeTLS13 reports whether the peer's leaf certificate may
+// sign a TLS 1.3 CertificateVerify with scheme. The schemes this package
+// implements are bound to public key types that it supports (ECDSA schemes
+// to a curve), so a key that it doesn't support may only use other schemes,
+// which Config.VerifyUnsupportedSignature verifies.
+func isPeerSignatureSchemeTLS13(leaf *x509.Certificate, scheme SignatureScheme) bool {
+	if leaf.PublicKey == nil {
+		_, _, err := typeAndHashFromSignatureScheme(scheme)
+		return err != nil
+	}
+	return isSupportedSignatureAlgorithm(scheme, signatureSchemesForPublicKey(VersionTLS13, leaf.PublicKey))
+}
