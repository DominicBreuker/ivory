new file mode 100644
--- /dev/null
+++ b/src/crypto/tls/unsupported_key_test.go
@@ -0,0 +1,586 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls
+
+import (
+	"crypto"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/asn1"
+	"errors"
+	"math/big"
+	"net"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/crypto/cryptobyte"
+	cryptobyte_asn1 "golang.org/x/crypto/cryptobyte/asn1"
+)
+
+// oidUnsupportedCurve names an elliptic curve that this package doesn't
+// support. It is under the enterprise number reserved for documentation
+// (RFC 5612). Certificates with it carry a P-256 point, so tests can sign
+// and verify with crypto/ecdsa.
+var oidUnsupportedCurve = asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 32473, 1}
+
+var oidPublicKeyECDSA = asn1.ObjectIdentifier{1, 2, 840, 10045, 2, 1}
+
+// unsupportedKeyCertificate returns a certificate and key for a peer whose
+// public key this package doesn't support (x509.Certificate.PublicKey is
+// nil), and a pool with the CA that issued it.
+func unsupportedKeyCertificate(t *testing.T, cn string) (Certificate, *x509.CertPool) {
+	t.Helper()
+	caKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	caTmpl := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: "unsupported key CA"},
+		NotBefore:             testTime().Add(-time.Hour),
+		NotAfter:              testTime().Add(time.Hour),
+		KeyUsage:              x509.KeyUsageCertSign,
+		BasicConstraintsValid: true,
+		IsCA:                  true,
+	}
+	caDER, err := x509.CreateCertificate(rand.Reader, caTmpl, caTmpl, caKey.Public(), caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ca, err := x509.ParseCertificate(caDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber:       big.NewInt(2),
+		Subject:            pkix.Name{CommonName: cn},
+		DNSNames:           []string{cn},
+		NotBefore:          testTime().Add(-time.Hour),
+		NotAfter:           testTime().Add(time.Hour),
+		KeyUsage:           x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:        []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth, x509.ExtKeyUsageClientAuth},
+		SignatureAlgorithm: x509.ECDSAWithSHA256,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, ca, key.Public(), caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Replace the curve OID in the subjectPublicKeyInfo, the seventh field
+	// of the TBSCertificate, and sign again.
+	point, err := key.PublicKey.Bytes()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var spki cryptobyte.Builder
+	spki.AddASN1(cryptobyte_asn1.SEQUENCE, func(b *cryptobyte.Builder) {
+		b.AddASN1(cryptobyte_asn1.SEQUENCE, func(b *cryptobyte.Builder) {
+			b.AddASN1ObjectIdentifier(oidPublicKeyECDSA)
+			b.AddASN1ObjectIdentifier(oidUnsupportedCurve)
+		})
+		b.AddASN1BitString(point)
+	})
+	in := cryptobyte.String(cert.RawTBSCertificate)
+	if !in.ReadASN1(&in, cryptobyte_asn1.SEQUENCE) {
+		t.Fatal("malformed TBSCertificate")
+	}
+	var tbs cryptobyte.Builder
+	tbs.AddASN1(cryptobyte_asn1.SEQUENCE, func(b *cryptobyte.Builder) {
+		for i := 0; !in.Empty(); i++ {
+			var field cryptobyte.String
+			if !in.ReadAnyASN1Element(&field, nil) {
+				t.Fatal("malformed TBSCertificate")
+			}
+			if i == 6 {
+				field = spki.BytesOrPanic()
+			}
+			b.AddBytes(field)
+		}
+	})
+	tbsDER := tbs.BytesOrPanic()
+	h := crypto.SHA256.New()
+	h.Write(tbsDER)
+	sig, err := ecdsa.SignASN1(rand.Reader, caKey, h.Sum(nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out cryptobyte.Builder
+	out.AddASN1(cryptobyte_asn1.SEQUENCE, func(b *cryptobyte.Builder) {
+		b.AddBytes(tbsDER)
+		b.AddBytes(cert.RawSignatureAlgorithm)
+		b.AddASN1BitString(sig)
+	})
+	leafDER := out.BytesOrPanic()
+
+	leaf, err := x509.ParseCertificate(leafDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if leaf.PublicKey != nil {
+		t.Fatalf("test certificate has a supported %T key", leaf.PublicKey)
+	}
+	if err := leaf.CheckSignatureFrom(ca); err != nil {
+		t.Fatal(err)
+	}
+	pool := x509.NewCertPool()
+	pool.AddCert(ca)
+	return Certificate{Certificate: [][]byte{leafDER}, PrivateKey: key}, pool
+}
+
+// verifyUnsupportedCurveSignature is a Config.VerifyUnsupportedSignature
+// for certificates made by unsupportedKeyCertificate.
+func verifyUnsupportedCurveSignature(leaf *x509.Certificate, scheme SignatureScheme, signed, sig []byte) error {
+	var alg, curve asn1.ObjectIdentifier
+	var point asn1.BitString
+	spki := cryptobyte.String(leaf.RawSubjectPublicKeyInfo)
+	var algID cryptobyte.String
+	if !spki.ReadASN1(&spki, cryptobyte_asn1.SEQUENCE) ||
+		!spki.ReadASN1(&algID, cryptobyte_asn1.SEQUENCE) ||
+		!algID.ReadASN1ObjectIdentifier(&alg) ||
+		!algID.ReadASN1ObjectIdentifier(&curve) ||
+		!spki.ReadASN1BitString(&point) {
+		return errors.New("malformed subjectPublicKeyInfo")
+	}
+	if !alg.Equal(oidPublicKeyECDSA) || !curve.Equal(oidUnsupportedCurve) {
+		return errors.New("unexpected key type")
+	}
+	pub, err := ecdsa.ParseUncompressedPublicKey(elliptic.P256(), point.RightAlign())
+	if err != nil {
+		return err
+	}
+	var h crypto.Hash
+	switch scheme {
+	case ECDSAWithP256AndSHA256:
+		h = crypto.SHA256
+	case ECDSAWithP384AndSHA384:
+		h = crypto.SHA384
+	case ECDSAWithP521AndSHA512:
+		h = crypto.SHA512
+	default:
+		return errors.New("unsupported signature scheme")
+	}
+	hh := h.New()
+	hh.Write(signed)
+	if !ecdsa.VerifyASN1(pub, hh.Sum(nil), sig) {
+		return errors.New("ECDSA verification failure")
+	}
+	return nil
+}
+
+type unsupportedKeyTest struct {
+	name        string
+	version     uint16
+	hook        func(leaf *x509.Certificate, scheme SignatureScheme, signed, sig []byte) error
+	clientErr   string // substring of the client's error; "" for success
+	serverErr   string // substring of the server's error; "" for success
+	wantHookRun bool
+}
+
+var errTestHook = errors.New("test hook rejects the signature")
+
+func unsupportedKeyTests() []unsupportedKeyTest {
+	return []unsupportedKeyTest{
+		{
+			name:    "no hook",
+			version: VersionTLS12,
+		},
+		{
+			name:        "hook",
+			version:     VersionTLS12,
+			hook:        verifyUnsupportedCurveSignature,
+			wantHookRun: true,
+		},
+		{
+			name:    "hook fails",
+			version: VersionTLS12,
+			hook: func(*x509.Certificate, SignatureScheme, []byte, []byte) error {
+				return errTestHook
+			},
+			wantHookRun: true,
+		},
+		{
+			name:    "TLS 1.3 no hook",
+			version: VersionTLS13,
+		},
+		{
+			// In TLS 1.3, ECDSAWithP256AndSHA256 is bound to P-256, so a
+			// key that this package doesn't support can't use it.
+			name:    "TLS 1.3 implemented scheme",
+			version: VersionTLS13,
+			hook:    verifyUnsupportedCurveSignature,
+		},
+	}
+}
