+package tls
+
+import (
+	"slices"
+	"testing"
+)
+
+// TestECDSASuitesFirst checks that a client with Config.CipherSuites offers
+// its ECDHE_ECDSA suites before its ECDHE_RSA suites of the same kind, as
+// gemSpec_Krypt A_17124-03 and A_17094-02 require, whatever the order of
+// Config.CipherSuites.
+func TestECDSASuitesFirst(t *testing.T) {
+	for _, tt := range []struct {
+		name   string
+		suites []uint16
+		want   []uint16
+	}{
+		{"TI suites, RSA first", []uint16{
+			TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384, TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,
+			TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384, TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,
+		}, []uint16{
+			TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,
+			TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,
+		}},
+		{"AEAD before CBC", []uint16{
+			TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA, TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA,
+			TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, TLS_RSA_WITH_AES_128_GCM_SHA256,
+			TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,
+		}, []uint16{
+			TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,
+			TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA, TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA,
+			TLS_RSA_WITH_AES_128_GCM_SHA256,
+		}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			for _, aes := range []bool{true, false} {
+				got := (&Config{CipherSuites: tt.suites}).cipherSuites(aes)
+				if !slices.Equal(got, tt.want) {
+					t.Errorf("cipherSuites(%v) = %x, want %x", aes, got, tt.want)
+				}
+			}
+
+			var hello []uint16
+			serverConfig := testConfigServer.Clone()
+			serverConfig.GetConfigForClient = func(chi *ClientHelloInfo) (*Config, error) {
+				hello = slices.Clone(chi.CipherSuites)
+				return nil, nil
+			}
+			clientConfig := testConfigClient.Clone()
+			clientConfig.MaxVersion = VersionTLS12
+			clientConfig.CipherSuites = tt.suites
+			serverConfig.CipherSuites = tt.suites
+			if _, _, err := testHandshake(t, clientConfig, serverConfig); err != nil {
+				t.Fatal(err)
+			}
+			hello = slices.DeleteFunc(hello, func(id uint16) bool { return id == scsvRenegotiation })
+			if !slices.Equal(hello, tt.want) {
+				t.Errorf("ClientHello cipher_suites = %x, want %x", hello, tt.want)
+			}
+		})
+	}
+
+	// Without Config.CipherSuites, the default order is unchanged.
+	if got, want := (&Config{}).cipherSuites(true), defaultCipherSuites(true); !slices.Equal(got, want) {
+		t.Errorf("default cipherSuites = %x, want %x", got, want)
+	}
+}
