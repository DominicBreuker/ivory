+// ecdsaSuitesFirst reorders ids, a list in preference order, so that among
+// suites of the same kind the ECDHE_ECDSA suites come before the ECDHE_RSA
+// suites. The kinds are those of the preference order rules (RC4,
+// CBC_SHA256, 3DES, non-ECDHE, CBC), and the order is otherwise kept.
+// gemSpec_Krypt A_17124-03 and A_17094-02 require TLS clients in the German
+// health care network to offer the ECDHE_ECDSA suites before RSA suites;
+// such clients configure Config.CipherSuites, as the network allows only
+// some suites.
+func ecdsaSuitesFirst(ids []uint16) []uint16 {
+	kind := func(id uint16) int {
+		c, name := cipherSuiteByID(id), CipherSuiteName(id)
+		k := 0
+		if strings.Contains(name, "RC4") {
+			k |= 16
+		}
+		if strings.Contains(name, "CBC_SHA256") {
+			k |= 8
+		}
+		if strings.Contains(name, "3DES") {
+			k |= 4
+		}
+		if c.flags&suiteECDHE == 0 {
+			k |= 2
+		}
+		if c.aead == nil {
+			k |= 1
+		}
+		return k
+	}
+	rsa := func(id uint16) int {
+		if cipherSuiteByID(id).flags&suiteECSign != 0 {
+			return 0
+		}
+		return 1
+	}
+	slices.SortStableFunc(ids, func(a, b uint16) int {
+		if ka, kb := kind(a), kind(b); ka != kb {
+			return ka - kb
+		}
+		return rsa(a) - rsa(b)
+	})
+	return ids
+}
+
 // supportedCipherSuites returns the supported TLS 1.0–1.2 cipher suites in an
 // undefined order. For preference ordering, use [Config.cipherSuites].
 func (c *Config) supportedCipherSuites() []uint16 {
