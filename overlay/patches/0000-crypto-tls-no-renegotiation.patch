+// TestServerRejectsRenegotiation checks that a server answers a ClientHello
+// sent after the handshake with a fatal no_renegotiation alert.
+func TestServerRejectsRenegotiation(t *testing.T) {
+	c, s := localPipe(t)
+	clientConfig := testConfigClient.Clone()
+	clientConfig.MaxVersion = VersionTLS12
+	cli := Client(c, clientConfig)
+	defer cli.Close()
+
+	serverErr := make(chan error, 1)
+	go func() {
+		srv := Server(s, testConfigServer.Clone())
+		defer srv.Close()
+		if err := srv.Handshake(); err != nil {
+			serverErr <- err
+			return
+		}
+		_, err := srv.Read(make([]byte, 1))
+		serverErr <- err
+	}()
+
+	if err := cli.Handshake(); err != nil {
+		t.Fatalf("handshake failed: %v", err)
+	}
+	// crypto/tls clients never renegotiate on their own, so send the
+	// ClientHello by hand.
+	clientHello := &clientHelloMsg{
+		vers:                         VersionTLS12,
+		random:                       make([]byte, 32),
+		cipherSuites:                 []uint16{TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256},
+		compressionMethods:           []uint8{compressionNone},
+		secureRenegotiationSupported: true,
+		secureRenegotiation:          cli.clientFinished[:],
+		supportedCurves:              []CurveID{CurveP256},
+		supportedPoints:              []uint8{pointFormatUncompressed},
+	}
+	if _, err := cli.writeHandshakeRecord(clientHello, nil); err != nil {
+		t.Fatalf("writing ClientHello: %v", err)
+	}
+
+	err := <-serverErr
+	if opErr, ok := errors.AsType[*net.OpError](err); !ok || opErr.Op != "local error" || opErr.Err != error(alertNoRenegotiation) {
+		t.Errorf("server error = %v; want local error: %v", err, error(alertNoRenegotiation))
+	}
+	_, err = cli.Read(make([]byte, 1))
+	if opErr, ok := errors.AsType[*net.OpError](err); !ok || opErr.Op != "remote error" || opErr.Err != error(alertNoRenegotiation) {
+		t.Errorf("client error = %v; want remote error: %v", err, error(alertNoRenegotiation))
+	}
+}
