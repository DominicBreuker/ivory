new file mode 100644
--- /dev/null
+++ b/src/crypto/tls/signature_schemes_test.go
@@ -0,0 +1,160 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls
+
+import (
+	"slices"
+	"strings"
+	"testing"
+)
+
+// recordSignatureSchemes makes config record the signature_algorithms of
+// the ClientHellos it receives.
+func recordSignatureSchemes(config *Config) *[]SignatureScheme {
+	var schemes []SignatureScheme
+	config.GetConfigForClient = func(chi *ClientHelloInfo) (*Config, error) {
+		schemes = slices.Clone(chi.SignatureSchemes)
+		return nil, nil
+	}
+	return &schemes
+}
+
+func TestSignatureSchemesAdvertised(t *testing.T) {
+	skipFIPS(t) // Unsupported schemes are dropped in FIPS 140-3 mode; see TestSignatureSchemesFIPS.
+	list := []SignatureScheme{ECDSAWithP256AndSHA256, testSchemeUnimplemented, PSSWithSHA256, PKCS1WithSHA1}
+	for _, tt := range []struct {
+		name       string
+		schemes    []SignatureScheme
+		hook       bool
+		maxVersion uint16
+		want       []SignatureScheme
+	}{
+		{"default", nil, false, 0, supportedSignatureAlgorithms(VersionTLS12, VersionTLS13)},
+		// SHA-1 is disabled in TLS 1.2 (tlssha1=0) and TLS 1.3.
+		{"no hook", list, false, 0, []SignatureScheme{ECDSAWithP256AndSHA256, PSSWithSHA256}},
+		{"hook", list, true, 0, []SignatureScheme{ECDSAWithP256AndSHA256, testSchemeUnimplemented, PSSWithSHA256}},
+		{"hook, TLS 1.2", list, true, VersionTLS12, []SignatureScheme{ECDSAWithP256AndSHA256, PSSWithSHA256}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			clientConfig := testConfigClient.Clone()
+			clientConfig.MaxVersion = tt.maxVersion
+			clientConfig.SignatureSchemes = tt.schemes
+			if tt.hook {
+				clientConfig.VerifyUnsupportedSignature = verifyTestScheme
+			}
+			serverConfig := testConfigServer.Clone()
+			got := recordSignatureSchemes(serverConfig)
+			if _, _, err := testHandshake(t, clientConfig, serverConfig); err != nil {
+				t.Fatal(err)
+			}
+			if !slices.Equal(*got, tt.want) {
+				t.Errorf("signature_algorithms = %v, want %v", *got, tt.want)
+			}
+		})
+	}
+
+	// signature_algorithms_cert keeps the algorithms that are only
+	// disabled for handshake signatures.
+	config := &Config{SignatureSchemes: list, VerifyUnsupportedSignature: verifyTestScheme}
+	if got := config.supportedSignatureAlgorithmsCert(VersionTLS12, VersionTLS13); !slices.Equal(got, list) {
+		t.Errorf("signature_algorithms_cert = %v, want %v", got, list)
+	}
+	if got, want := (*Config)(nil).supportedSignatureAlgorithmsCert(VersionTLS12, VersionTLS13), supportedSignatureAlgorithmsCert(VersionTLS12, VersionTLS13); !slices.Equal(got, want) {
+		t.Errorf("default signature_algorithms_cert = %v, want %v", got, want)
+	}
+}
+
+func TestSignatureSchemesAccepted(t *testing.T) {
+	t.Run("server certificate", func(t *testing.T) {
+		// The server has only an ECDSA certificate.
+		clientConfig := testConfigClient.Clone()
+		clientConfig.SignatureSchemes = []SignatureScheme{PSSWithSHA256}
+		serverConfig := testConfigServer.Clone()
+		serverConfig.Certificates = []Certificate{testECDSAP256Cert}
+		_, serverErr := fipsHandshake(t, clientConfig, serverConfig)
+		if serverErr == nil || !strings.Contains(serverErr.Error(), "doesn't support any of the certificate's signature algorithms") {
+			t.Errorf("server error = %v, want no common signature algorithm", serverErr)
+		}
+	})
+
+	t.Run("client certificate", func(t *testing.T) {
+		// The client has only a P-256 certificate.
+		serverConfig := testConfigServer.Clone()
+		serverConfig.ClientAuth = RequireAnyClientCert
+		serverConfig.SignatureSchemes = []SignatureScheme{ECDSAWithP384AndSHA384}
+		clientConfig := testConfigClient.Clone()
+		clientConfig.Certificates = []Certificate{testClientECDSAP256Cert}
+		_, serverErr := fipsHandshake(t, clientConfig, serverConfig)
+		if serverErr == nil || !strings.Contains(serverErr.Error(), "client didn't provide a certificate") {
+			t.Errorf("server error = %v, want no client certificate", serverErr)
+		}
+	})
+}
+
+// TestSignatureSchemesUnsupportedKey checks the TLS 1.3 handshake with a
+// peer whose key this package doesn't support, signing with an algorithm
+// this package doesn't implement, advertised through SignatureSchemes.
+func TestSignatureSchemesUnsupportedKey(t *testing.T) {
+	skipFIPS(t) // Unsupported schemes are dropped in FIPS 140-3 mode; see TestSignatureSchemesFIPS.
+	schemes := append(defaultSupportedSignatureAlgorithms(), testSchemeUnimplemented)
+	for _, tt := range []struct {
+		name      string
+		client    bool // whether the unsupported key is the client's
+		schemes   []SignatureScheme
+		hook      bool
+		wantError string
+	}{
+		{"server", false, schemes, true, ""},
+		{"client", true, schemes, true, ""},
+		{"server, not advertised", false, defaultSupportedSignatureAlgorithms(), true, "peer doesn't support any of the certificate's signature algorithms"},
+		{"server, no hook", false, schemes, false, "peer doesn't support any of the certificate's signature algorithms"},
+		// The CertificateRequest leaves out testSchemeUnimplemented, so the
+		// client has no certificate to send.
+		{"client, no hook", true, schemes, false, "client didn't provide a certificate"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			cert, _, pool := unimplementedSchemeCertificate(t, "peer.example", ECDSAWithP256AndSHA256, testSchemeUnimplemented)
+			clientConfig := testConfigClient.Clone()
+			clientConfig.InsecureSkipVerify = true
+			serverConfig := testConfigServer.Clone()
+			verifier := clientConfig
+			if tt.client {
+				clientConfig.Certificates = []Certificate{cert}
+				serverConfig.ClientAuth = RequireAnyClientCert
+				serverConfig.ClientCAs = pool
+				verifier = serverConfig
+			} else {
+				serverConfig.Certificates = []Certificate{cert}
+			}
+			verifier.SignatureSchemes = tt.schemes
+			if tt.hook {
+				verifier.VerifyUnsupportedSignature = verifyTestScheme
+			}
+			clientErr, serverErr := fipsHandshake(t, clientConfig, serverConfig)
+			if tt.wantError == "" {
+				if clientErr != nil || serverErr != nil {
+					t.Fatalf("handshake failed: client: %v, server: %v", clientErr, serverErr)
+				}
+				return
+			}
+			if serverErr == nil || !strings.Contains(serverErr.Error(), tt.wantError) {
+				t.Errorf("server error = %v, want %q", serverErr, tt.wantError)
+			}
+		})
+	}
+}
+
+func TestSignatureSchemesFIPS(t *testing.T) {
+	runWithFIPSEnabled(t, func(t *testing.T) {
+		config := &Config{
+			SignatureSchemes:           []SignatureScheme{ECDSAWithP256AndSHA256, testSchemeUnimplemented, Ed25519},
+			VerifyUnsupportedSignature: verifyTestScheme,
+		}
+		got := config.supportedSignatureAlgorithms(VersionTLS12, VersionTLS13)
+		if slices.Contains(got, testSchemeUnimplemented) {
+			t.Errorf("signature_algorithms = %v in FIPS 140-3 mode, want no %v", got, testSchemeUnimplemented)
+		}
+	})
+}
