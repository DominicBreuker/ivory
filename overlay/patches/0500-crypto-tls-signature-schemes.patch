+// supportedSignatureAlgorithms is like the function of the same name, but
+// returns c.SignatureSchemes if set.
+func (c *Config) supportedSignatureAlgorithms(minVers, maxVers uint16) []SignatureScheme {
+	if c == nil || c.SignatureSchemes == nil {
+		return supportedSignatureAlgorithms(minVers, maxVers)
+	}
+	return c.signatureSchemes(minVers, maxVers, false)
+}
+
+// supportedSignatureAlgorithmsCert is like the function of the same name,
+// but returns c.SignatureSchemes if set.
+func (c *Config) supportedSignatureAlgorithmsCert(minVers, maxVers uint16) []SignatureScheme {
+	if c == nil || c.SignatureSchemes == nil {
+		return supportedSignatureAlgorithmsCert(minVers, maxVers)
+	}
+	return c.signatureSchemes(minVers, maxVers, true)
+}
+
+// signatureSchemes returns the algorithms of c.SignatureSchemes that are
+// enabled at a version from minVers to maxVers. Algorithms that this package
+// doesn't implement are kept for TLS 1.3 if VerifyUnsupportedSignature can
+// be used, since only peers whose keys this package doesn't support can use
+// them.
+func (c *Config) signatureSchemes(minVers, maxVers uint16, isCert bool) []SignatureScheme {
+	return slices.DeleteFunc(slices.Clone(c.SignatureSchemes), func(s SignatureScheme) bool {
+		if _, _, err := typeAndHashFromSignatureScheme(s); err != nil {
+			return maxVers < VersionTLS13 || !c.supportsUnsupportedPeerKey(VersionTLS13)
+		}
+		for v := minVers; v <= maxVers; v++ {
+			if !isDisabledSignatureAlgorithm(v, s, isCert) {
+				return false
+			}
+		}
+		return true
+	})
+}
