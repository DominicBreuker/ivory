-		certReq.certificateTypes = []byte{
-			byte(certTypeRSASign),
-			byte(certTypeECDSASign),
+		// Send exactly one certificate type, the one that matches the
+		// cipher suite, as gemSpec_Krypt A_22454 requires of an
+		// eHealth-KT. TLS 1.2 allows both on every suite.
+		ecSign := hs.suite.flags&suiteECSign != 0
+		if ecSign {
+			certReq.certificateTypes = []byte{byte(certTypeECDSASign)}
+		} else {
+			certReq.certificateTypes = []byte{byte(certTypeRSASign)}
 		}
 		if c.vers >= VersionTLS12 {
 			certReq.hasSignatureAlgorithm = true
-			certReq.supportedSignatureAlgorithms = c.config.supportedSignatureAlgorithms(c.vers, c.vers)
+			// Offer only the signature algorithms of that certificate
+			// type, so that the two lists agree. ecdsa_sign also
+			// covers Ed25519 (RFC 8422, Section 5.5).
+			certReq.supportedSignatureAlgorithms = slices.DeleteFunc(c.config.supportedSignatureAlgorithms(c.vers, c.vers), func(s SignatureScheme) bool {
+				sigType, _, err := typeAndHashFromSignatureScheme(s)
+				return err != nil || (sigType == signatureECDSA || sigType == signatureEd25519) != ecSign
+			})
 		}
 
 		// An empty list of certificateAuthorities signals to
