crypto/tls: send one CertificateRequest certificate type per suite

A TLS 1.2 server sends the certificate_types rsa_sign and ecdsa_sign in
its CertificateRequest, whatever the cipher suite. gemSpec_Krypt
A_22454 requires an eHealth card terminal to send exactly one type:
ecdsa_sign on ECDHE_ECDSA suites, rsa_sign on RSA suites. A Go client
then picks the client certificate that matches the suite.

This refuses RSA client certificates on ECDSA suites (and the reverse)
for clients that follow certificate_types, which TLS 1.2 allows. It is
for the overlay profile of eHealth card terminals only and is not meant
for upstream.

The TLS 1.2 TestClientAuth recordings were regenerated with OpenSSL
1.1.1w (as handshake_test.go requires); the RSA client certificate cases
and TestPKCS1OnlyCert now use a server with an RSA certificate, so that
the suite asks for RSA certificates.

ivory: P6, profile kt only. Base: go1.27.2 with P0-P5.
Requirement: A_22454 (gemSpec_Krypt V2.51.0). Upstream: never.
Probe: K3.

diff --git a/src/crypto/tls/certificate_types_test.go b/src/crypto/tls/certificate_types_test.go
new file mode 100644
--- /dev/null
+++ b/src/crypto/tls/certificate_types_test.go
@@ -0,0 +1,91 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls
+
+import (
+	"bytes"
+	"net"
+	"sync"
+	"testing"
+)
+
+// certificateRequestRecorder is a net.Conn that records the
+// certificate_types of the TLS 1.2 CertificateRequest it writes.
+type certificateRequestRecorder struct {
+	net.Conn
+	mu        sync.Mutex
+	certTypes []byte
+}
+
+func (c *certificateRequestRecorder) Write(b []byte) (int, error) {
+	for rec := b; len(rec) > recordHeaderLen; {
+		n := recordHeaderLen + (int(rec[3])<<8 | int(rec[4]))
+		if n > len(rec) {
+			break
+		}
+		if recordType(rec[0]) == recordTypeHandshake && rec[recordHeaderLen] == typeCertificateRequest {
+			body := rec[recordHeaderLen+4 : n]
+			c.mu.Lock()
+			c.certTypes = bytes.Clone(body[1 : 1+int(body[0])])
+			c.mu.Unlock()
+		}
+		rec = rec[n:]
+	}
+	return c.Conn.Write(b)
+}
+
+// TestCertificateRequestTypes checks that a TLS 1.2 server asks for exactly
+// one client certificate type, the one that matches the cipher suite
+// (gemSpec_Krypt A_22454), and that a client with both certificate types
+// sends the matching one.
+func TestCertificateRequestTypes(t *testing.T) {
+	for _, tt := range []struct {
+		name      string
+		suite     uint16
+		cert      Certificate
+		wantTypes []byte
+		wantLeaf  Certificate
+	}{
+		{"ECDHE_ECDSA", TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, testECDSAP256Cert, []byte{certTypeECDSASign}, testClientECDSAP256Cert},
+		{"ECDHE_RSA", TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, testRSA2048Cert, []byte{certTypeRSASign}, testClientRSA2048Cert},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			serverConfig := testConfigServer.Clone()
+			serverConfig.MaxVersion = VersionTLS12
+			serverConfig.Certificates = []Certificate{tt.cert}
+			serverConfig.ClientAuth = RequireAnyClientCert
+			clientConfig := testConfigClient.Clone()
+			clientConfig.CipherSuites = []uint16{tt.suite}
+			clientConfig.Certificates = []Certificate{testClientRSA2048Cert, testClientECDSAP256Cert}
+
+			c, s := localPipe(t)
+			rec := &certificateRequestRecorder{Conn: s}
+			done := make(chan error, 1)
+			var peer []byte
+			go func() {
+				srv := Server(rec, serverConfig)
+				err := srv.Handshake()
+				if err == nil {
+					peer = srv.ConnectionState().PeerCertificates[0].Raw
+				}
+				s.Close()
+				done <- err
+			}()
+			clientErr := Client(c, clientConfig).Handshake()
+			c.Close()
+			if serverErr := <-done; clientErr != nil || serverErr != nil {
+				t.Fatalf("client: %v, server: %v", clientErr, serverErr)
+			}
+			rec.mu.Lock()
+			defer rec.mu.Unlock()
+			if !bytes.Equal(rec.certTypes, tt.wantTypes) {
+				t.Errorf("certificate_types = %x, want %x", rec.certTypes, tt.wantTypes)
+			}
+			if !bytes.Equal(peer, tt.wantLeaf.Certificate[0]) {
+				t.Error("client sent the certificate of the other type")
+			}
+		})
+	}
+}
