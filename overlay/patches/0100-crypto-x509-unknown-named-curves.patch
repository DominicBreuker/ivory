+func TestParseCertificateUnsupportedCurve(t *testing.T) {
+	root, rootKey := p256CA(t)
+	for _, tt := range unsupportedCurveSPKIs {
+		t.Run(tt.name, func(t *testing.T) {
+			spki := mustDecodeHex(t, tt.spki)
+			der := createCertificateWithSPKI(t, unsupportedCurveTemplate("leaf", 2, false), root, spki, rootKey)
+			cert, err := ParseCertificate(der)
+			if err != nil {
+				t.Fatalf("ParseCertificate: %v", err)
+			}
+			if cert.PublicKeyAlgorithm != UnknownPublicKeyAlgorithm {
+				t.Errorf("PublicKeyAlgorithm = %v, want UnknownPublicKeyAlgorithm", cert.PublicKeyAlgorithm)
+			}
+			if cert.PublicKey != nil {
+				t.Errorf("PublicKey = %T, want nil", cert.PublicKey)
+			}
+			if !bytes.Equal(cert.RawSubjectPublicKeyInfo, spki) {
+				t.Errorf("RawSubjectPublicKeyInfo = %x, want %x", cert.RawSubjectPublicKeyInfo, spki)
+			}
+			if cert.Subject.CommonName != "leaf" {
+				t.Errorf("Subject.CommonName = %q, want %q", cert.Subject.CommonName, "leaf")
+			}
+			if len(cert.DNSNames) != 1 || cert.DNSNames[0] != "example.com" {
+				t.Errorf("DNSNames = %q, want [example.com]", cert.DNSNames)
+			}
+			if len(cert.ExtKeyUsage) != 1 || cert.ExtKeyUsage[0] != ExtKeyUsageServerAuth {
+				t.Errorf("ExtKeyUsage = %v, want [ServerAuth]", cert.ExtKeyUsage)
+			}
+			if cert.SignatureAlgorithm != ECDSAWithSHA256 || len(cert.RawSignatureAlgorithm) == 0 {
+				t.Errorf("SignatureAlgorithm = %v (raw %x), want ECDSAWithSHA256", cert.SignatureAlgorithm, cert.RawSignatureAlgorithm)
+			}
+			if err := cert.CheckSignatureFrom(root); err != nil {
+				t.Errorf("CheckSignatureFrom(root): %v", err)
+			}
+
+			// ParsePKIXPublicKey has nothing to return for such a key.
+			if _, err := ParsePKIXPublicKey(spki); err == nil || err.Error() != unsupportedCurveError {
+				t.Errorf("ParsePKIXPublicKey: err = %v, want %q", err, unsupportedCurveError)
+			}
+		})
+	}
+}
