+func TestVerifyUnsupportedCurve(t *testing.T) {
+	root, rootKey := p256CA(t)
+	spki := mustDecodeHex(t, unsupportedCurveSPKIs[0].spki)
+	roots := NewCertPool()
+	roots.AddCert(root)
+
+	t.Run("leaf", func(t *testing.T) {
+		der := createCertificateWithSPKI(t, unsupportedCurveTemplate("leaf", 2, false), root, spki, rootKey)
+		leaf, err := ParseCertificate(der)
+		if err != nil {
+			t.Fatal(err)
+		}
+		// The signature is good, but Verify must not return the chain.
+		if err := leaf.CheckSignatureFrom(root); err != nil {
+			t.Fatalf("CheckSignatureFrom: %v", err)
+		}
+		_, err = leaf.Verify(VerifyOptions{Roots: roots, DNSName: "example.com"})
+		var invalid CertificateInvalidError
+		if !errors.As(err, &invalid) || invalid.Reason != NoValidChains || !strings.Contains(err.Error(), "unsupported elliptic curve") {
+			t.Errorf("Verify: err = %v, want a CertificateInvalidError about the unsupported curve", err)
+		}
+	})
+
+	// A certificate issued by a CA with an unsupported key can't be
+	// checked, so such CAs are never part of a chain.
+	newLeafKey := func() *ecdsa.PrivateKey {
+		k, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return k
+	}
+	issuedBy := func(t *testing.T, issuer *Certificate) *Certificate {
+		// The signature of the leaf is made by a P-256 key that doesn't
+		// match the issuer: there is no way to sign with the issuer's key.
+		k := newLeafKey()
+		der, err := CreateCertificate(rand.Reader, unsupportedCurveTemplate("leaf", 4, false), issuer, k.Public(), k)
+		if err != nil {
+			t.Fatal(err)
+		}
+		leaf, err := ParseCertificate(der)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return leaf
+	}
+
+	t.Run("intermediate", func(t *testing.T) {
+		der := createCertificateWithSPKI(t, unsupportedCurveTemplate("intermediate", 3, true), root, spki, rootKey)
+		inter, err := ParseCertificate(der)
+		if err != nil {
+			t.Fatal(err)
+		}
+		intermediates := NewCertPool()
+		intermediates.AddCert(inter)
+		_, err = issuedBy(t, inter).Verify(VerifyOptions{Roots: roots, Intermediates: intermediates})
+		if _, ok := err.(UnknownAuthorityError); !ok {
+			t.Errorf("Verify: err = %v (%T), want UnknownAuthorityError", err, err)
+		}
+		// The intermediate itself is rejected as a leaf.
+		if _, err := inter.Verify(VerifyOptions{Roots: roots}); err == nil {
+			t.Error("Verify of the intermediate succeeded")
+		}
+	})
+
+	t.Run("root", func(t *testing.T) {
+		tmpl := unsupportedCurveTemplate("unsupported root", 5, true)
+		der := createCertificateWithSPKI(t, tmpl, tmpl, spki, rootKey)
+		badRoot, err := ParseCertificate(der)
+		if err != nil {
+			t.Fatal(err)
+		}
+		badRoots := NewCertPool()
+		badRoots.AddCert(badRoot)
+		leaf := issuedBy(t, badRoot)
+		_, err = leaf.Verify(VerifyOptions{Roots: badRoots})
+		if _, ok := err.(UnknownAuthorityError); !ok {
+			t.Errorf("Verify: err = %v (%T), want UnknownAuthorityError", err, err)
+		}
+		if err := leaf.CheckSignatureFrom(badRoot); err != ErrUnsupportedAlgorithm {
+			t.Errorf("CheckSignatureFrom = %v, want ErrUnsupportedAlgorithm", err)
+		}
+	})
+}
