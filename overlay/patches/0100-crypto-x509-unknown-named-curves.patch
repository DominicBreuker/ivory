+// brainpoolP256r1CSRPEM is a certificate request with a brainpoolP256r1 key,
+// generated with
+//
+//	openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:brainpoolP256r1 \
+//		-pkeyopt ec_param_enc:named_curve -out bp.key
+//	openssl req -new -key bp.key -sha256 -subj /CN=brainpool.example \
+//		-addext subjectAltName=DNS:brainpool.example
+const brainpoolP256r1CSRPEM = `-----BEGIN CERTIFICATE REQUEST-----
+MIIBBjCBrgIBADAcMRowGAYDVQQDDBFicmFpbnBvb2wuZXhhbXBsZTBaMBQGByqG
+SM49AgEGCSskAwMCCAEBBwNCAAQhWS2eJ1z3jBAmgVDR+nlYEzAE/VyPe6HtBwWM
+vHa9/0WXNGBCCQijb1mHJ+gfNmhfbh02H9bAPzaAWaP/cqTloC8wLQYJKoZIhvcN
+AQkOMSAwHjAcBgNVHREEFTATghFicmFpbnBvb2wuZXhhbXBsZTAKBggqhkjOPQQD
+AgNHADBEAiBTBRIbslaYpwZC/DJLPLKrUmIp7GxYAjFCFIhdQyJ+vAIgOFrxttBD
+6FzKAll5unSaiAg1GWI5eAtndNDnS5U363c=
+-----END CERTIFICATE REQUEST-----`
+
+// createCertificateRequestWithSPKI is like CreateCertificateRequest, but the
+// request carries the SubjectPublicKeyInfo spki. The request is signed by a
+// P-256 key, so its signature doesn't match spki.
+func createCertificateRequestWithSPKI(t *testing.T, spki []byte) []byte {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	der, err := CreateCertificateRequest(rand.Reader, &CertificateRequest{
+		Subject:  pkix.Name{CommonName: "request"},
+		DNSNames: []string{"example.com"},
+	}, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	csr, err := ParseCertificateRequest(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Replace the subjectPKInfo, the third field of the
+	// CertificationRequestInfo (RFC 2986, Section 4.1), and sign again.
+	in := cryptobyte.String(csr.RawTBSCertificateRequest)
+	if !in.ReadASN1(&in, cryptobyte_asn1.SEQUENCE) {
+		t.Fatal("malformed CertificationRequestInfo")
+	}
+	var b cryptobyte.Builder
+	b.AddASN1(cryptobyte_asn1.SEQUENCE, func(b *cryptobyte.Builder) {
+		for i := 0; !in.Empty(); i++ {
+			var field cryptobyte.String
+			if !in.ReadAnyASN1Element(&field, nil) {
+				t.Fatal("malformed CertificationRequestInfo")
+			}
+			if i == 2 {
+				field = spki
+			}
+			b.AddBytes(field)
+		}
+	})
+	tbs := b.BytesOrPanic()
+	digest := sha256.Sum256(tbs)
+	sig, err := ecdsa.SignASN1(rand.Reader, key, digest[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	b = cryptobyte.Builder{}
+	b.AddASN1(cryptobyte_asn1.SEQUENCE, func(b *cryptobyte.Builder) {
+		b.AddBytes(tbs)
+		b.AddBytes(csr.RawSignatureAlgorithm)
+		b.AddASN1BitString(sig)
+	})
+	return b.BytesOrPanic()
+}
