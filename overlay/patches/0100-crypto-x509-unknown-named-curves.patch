+// createCertificateWithSPKI is like CreateCertificate, but the certificate
+// carries the SubjectPublicKeyInfo spki, which CreateCertificate couldn't
+// marshal. The certificate is signed by priv, a P-256 key.
+func createCertificateWithSPKI(t *testing.T, template, parent *Certificate, spki []byte, priv *ecdsa.PrivateKey) []byte {
+	t.Helper()
+	placeholder, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template.SignatureAlgorithm = ECDSAWithSHA256
+	der, err := CreateCertificate(rand.Reader, template, parent, placeholder.Public(), priv)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert, err := ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Replace the subjectPublicKeyInfo, the seventh field of the
+	// TBSCertificate (RFC 5280, Section 4.1), and sign again.
+	in := cryptobyte.String(cert.RawTBSCertificate)
+	if !in.ReadASN1(&in, cryptobyte_asn1.SEQUENCE) {
+		t.Fatal("malformed TBSCertificate")
+	}
+	var b cryptobyte.Builder
+	b.AddASN1(cryptobyte_asn1.SEQUENCE, func(b *cryptobyte.Builder) {
+		for i := 0; !in.Empty(); i++ {
+			var field cryptobyte.String
+			if !in.ReadAnyASN1Element(&field, nil) {
+				t.Fatal("malformed TBSCertificate")
+			}
+			if i == 6 {
+				field = spki
+			}
+			b.AddBytes(field)
+		}
+	})
+	tbs := b.BytesOrPanic()
+	digest := sha256.Sum256(tbs)
+	sig, err := ecdsa.SignASN1(rand.Reader, priv, digest[:])
+	if err != nil {
+		t.Fatal(err)
+	}
+	b = cryptobyte.Builder{}
+	b.AddASN1(cryptobyte_asn1.SEQUENCE, func(b *cryptobyte.Builder) {
+		b.AddBytes(tbs)
+		b.AddBytes(cert.RawSignatureAlgorithm)
+		b.AddASN1BitString(sig)
+	})
+	return b.BytesOrPanic()
+}
