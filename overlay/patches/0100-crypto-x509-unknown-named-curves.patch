+// TestDropUnsupportedCurveChains tests the filter that Verify applies to the
+// chains returned by the platform verifiers on Windows, macOS and iOS.
+func TestDropUnsupportedCurveChains(t *testing.T) {
+	root, rootKey := p256CA(t)
+	spki := mustDecodeHex(t, unsupportedCurveSPKIs[0].spki)
+	der := createCertificateWithSPKI(t, unsupportedCurveTemplate("intermediate", 3, true), root, spki, rootKey)
+	unsupported, err := ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	k, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	der, err = CreateCertificate(rand.Reader, unsupportedCurveTemplate("leaf", 4, false), root, k.Public(), rootKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaf, err := ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	good := []*Certificate{leaf, root}
+	bad := []*Certificate{leaf, unsupported, root}
+	badRoot := []*Certificate{leaf, unsupported}
+	platformErr := errors.New("platform verifier failed")
+
+	for _, tt := range []struct {
+		name    string
+		chains  [][]*Certificate
+		err     error
+		want    [][]*Certificate
+		wantErr bool
+	}{
+		{"no unsupported keys", [][]*Certificate{good}, nil, [][]*Certificate{good}, false},
+		{"unsupported intermediate dropped", [][]*Certificate{bad, good}, nil, [][]*Certificate{good}, false},
+		{"unsupported root dropped", [][]*Certificate{good, badRoot}, nil, [][]*Certificate{good}, false},
+		{"no chain left", [][]*Certificate{bad, badRoot}, nil, nil, true},
+		{"platform error kept", nil, platformErr, nil, true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			chains, err := leaf.dropUnsupportedCurveChains(tt.chains, tt.err)
+			if tt.err != nil {
+				if err != tt.err {
+					t.Errorf("err = %v, want %v", err, tt.err)
+				}
+				return
+			}
+			if tt.wantErr {
+				var invalid CertificateInvalidError
+				if !errors.As(err, &invalid) || invalid.Reason != NoValidChains || invalid.Cert != leaf || !strings.Contains(err.Error(), "unsupported elliptic curve") {
+					t.Errorf("err = %v, want a CertificateInvalidError about the unsupported curve", err)
+				}
+				if chains != nil {
+					t.Errorf("chains = %v, want nil", chains)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("err = %v", err)
+			}
+			if !slices.EqualFunc(chains, tt.want, slices.Equal) {
+				t.Errorf("got %d chains, want %d", len(chains), len(tt.want))
+			}
+		})
+	}
+}
