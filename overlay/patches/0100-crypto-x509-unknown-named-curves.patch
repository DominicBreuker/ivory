+// dropUnsupportedCurveChains removes the chains, returned by a platform
+// verifier for the leaf c, that contain a certificate with a public key on a
+// curve this package doesn't implement. Such certificates used to fail
+// parsing, so Verify never returned them, and their signatures can't be
+// checked by this package. If no chain remains, it returns an error.
+func (c *Certificate) dropUnsupportedCurveChains(chains [][]*Certificate, err error) ([][]*Certificate, error) {
+	if err != nil {
+		return chains, err
+	}
+	kept := chains[:0:0]
+	for _, chain := range chains {
+		if !slices.ContainsFunc(chain, func(cert *Certificate) bool { return cert.unsupportedCurve }) {
+			kept = append(kept, chain)
+		}
+	}
