+func TestParseCertificateRequestUnsupportedCurve(t *testing.T) {
+	for _, tt := range unsupportedCurveSPKIs {
+		t.Run(tt.name, func(t *testing.T) {
+			spki := mustDecodeHex(t, tt.spki)
+			csr, err := ParseCertificateRequest(createCertificateRequestWithSPKI(t, spki))
+			if err != nil {
+				t.Fatalf("ParseCertificateRequest: %v", err)
+			}
+			if csr.PublicKeyAlgorithm != UnknownPublicKeyAlgorithm || csr.PublicKey != nil {
+				t.Errorf("PublicKeyAlgorithm, PublicKey = %v, %T; want UnknownPublicKeyAlgorithm, nil", csr.PublicKeyAlgorithm, csr.PublicKey)
+			}
+			if !bytes.Equal(csr.RawSubjectPublicKeyInfo, spki) {
+				t.Errorf("RawSubjectPublicKeyInfo = %x, want %x", csr.RawSubjectPublicKeyInfo, spki)
+			}
+			if csr.Subject.CommonName != "request" || len(csr.DNSNames) != 1 || csr.DNSNames[0] != "example.com" {
+				t.Errorf("Subject.CommonName, DNSNames = %q, %q; want request, [example.com]", csr.Subject.CommonName, csr.DNSNames)
+			}
+			if csr.SignatureAlgorithm != ECDSAWithSHA256 {
+				t.Errorf("SignatureAlgorithm = %v, want ECDSAWithSHA256", csr.SignatureAlgorithm)
+			}
+			if err := csr.CheckSignature(); err == nil {
+				t.Error("CheckSignature succeeded with an unsupported key")
+			}
+		})
+	}
+
+	t.Run("OpenSSL", func(t *testing.T) {
+		block, _ := pem.Decode([]byte(brainpoolP256r1CSRPEM))
+		csr, err := ParseCertificateRequest(block.Bytes)
+		if err != nil {
+			t.Fatalf("ParseCertificateRequest: %v", err)
+		}
+		if csr.PublicKeyAlgorithm != UnknownPublicKeyAlgorithm || csr.PublicKey != nil {
+			t.Errorf("PublicKeyAlgorithm, PublicKey = %v, %T; want UnknownPublicKeyAlgorithm, nil", csr.PublicKeyAlgorithm, csr.PublicKey)
+		}
+		if csr.Subject.CommonName != "brainpool.example" || len(csr.DNSNames) != 1 || csr.DNSNames[0] != "brainpool.example" {
+			t.Errorf("Subject.CommonName, DNSNames = %q, %q; want brainpool.example", csr.Subject.CommonName, csr.DNSNames)
+		}
+		if err := csr.CheckSignature(); err != ErrUnsupportedAlgorithm {
+			t.Errorf("CheckSignature = %v, want ErrUnsupportedAlgorithm", err)
+		}
+	})
+}
