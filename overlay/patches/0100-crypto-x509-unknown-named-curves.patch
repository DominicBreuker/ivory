+func TestParseCertificateUnsupportedCurveOpenSSL(t *testing.T) {
+	block, _ := pem.Decode([]byte(brainpoolP256r1SelfSignedPEM))
+	cert, err := ParseCertificate(block.Bytes)
+	if err != nil {
+		t.Fatalf("ParseCertificate: %v", err)
+	}
+	if cert.PublicKeyAlgorithm != UnknownPublicKeyAlgorithm || cert.PublicKey != nil {
+		t.Errorf("PublicKeyAlgorithm, PublicKey = %v, %T; want UnknownPublicKeyAlgorithm, nil", cert.PublicKeyAlgorithm, cert.PublicKey)
+	}
+	if cert.Subject.CommonName != "brainpool.example" || len(cert.DNSNames) != 1 || cert.DNSNames[0] != "brainpool.example" {
+		t.Errorf("Subject.CommonName, DNSNames = %q, %q; want brainpool.example", cert.Subject.CommonName, cert.DNSNames)
+	}
+	if !cert.IsCA || cert.SignatureAlgorithm != ECDSAWithSHA256 {
+		t.Errorf("IsCA, SignatureAlgorithm = %v, %v; want true, ECDSAWithSHA256", cert.IsCA, cert.SignatureAlgorithm)
+	}
+	// The parent's key is not supported.
+	if err := cert.CheckSignatureFrom(cert); err != ErrUnsupportedAlgorithm {
+		t.Errorf("CheckSignatureFrom(self) = %v, want ErrUnsupportedAlgorithm", err)
+	}
+	if err := cert.CheckSignature(cert.SignatureAlgorithm, cert.RawTBSCertificate, cert.Signature); err == nil {
+		t.Error("CheckSignature succeeded with an unsupported key")
+	}
+}
