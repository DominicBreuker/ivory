+func TestParseCertificatesUnsupportedCurveBundle(t *testing.T) {
+	root, rootKey := p256CA(t)
+	spki := mustDecodeHex(t, unsupportedCurveSPKIs[0].spki)
+	leaf := createCertificateWithSPKI(t, unsupportedCurveTemplate("leaf", 2, false), root, spki, rootKey)
+	certs, err := ParseCertificates(append(append([]byte{}, root.Raw...), leaf...))
+	if err != nil {
+		t.Fatalf("ParseCertificates: %v", err)
+	}
+	if len(certs) != 2 {
+		t.Fatalf("ParseCertificates returned %d certificates, want 2", len(certs))
+	}
+
+	var pemBundle bytes.Buffer
+	pem.Encode(&pemBundle, &pem.Block{Type: "CERTIFICATE", Bytes: root.Raw})
+	pem.Encode(&pemBundle, &pem.Block{Type: "CERTIFICATE", Bytes: leaf})
+	pemBundle.WriteString(brainpoolP256r1SelfSignedPEM)
+	pool := NewCertPool()
+	if !pool.AppendCertsFromPEM(pemBundle.Bytes()) {
+		t.Fatal("AppendCertsFromPEM returned false")
+	}
+	if n := pool.len(); n != 3 {
+		t.Errorf("pool has %d certificates, want 3", n)
+	}
+}
