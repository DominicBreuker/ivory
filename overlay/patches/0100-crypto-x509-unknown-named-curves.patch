+func TestUnknownCurveGODEBUG(t *testing.T) {
+	root, rootKey := p256CA(t)
+	spki := mustDecodeHex(t, unsupportedCurveSPKIs[0].spki)
+	certDER := createCertificateWithSPKI(t, unsupportedCurveTemplate("leaf", 2, false), root, spki, rootKey)
+	csrDER := createCertificateRequestWithSPKI(t, spki)
+
+	const name = "/godebug/non-default-behavior/x509unknowncurve:events"
+	samples := []metrics.Sample{{Name: name}}
+	count := func() uint64 {
+		metrics.Read(samples)
+		return samples[0].Value.Uint64()
+	}
+
+	for _, setting := range []string{"", "x509unknowncurve=1"} {
+		t.Run("GODEBUG="+setting, func(t *testing.T) {
+			t.Setenv("GODEBUG", setting)
+			before := count()
+			if _, err := ParseCertificate(certDER); err != nil {
+				t.Errorf("ParseCertificate: %v", err)
+			}
+			if _, err := ParseCertificateRequest(csrDER); err != nil {
+				t.Errorf("ParseCertificateRequest: %v", err)
+			}
+			if n := count() - before; n != 0 {
+				t.Errorf("%s increased by %d, want 0", name, n)
+			}
+		})
+	}
+
+	t.Run("GODEBUG=x509unknowncurve=0", func(t *testing.T) {
+		t.Setenv("GODEBUG", "x509unknowncurve=0")
+		before := count()
+		if _, err := ParseCertificate(certDER); err == nil || err.Error() != unsupportedCurveError {
+			t.Errorf("ParseCertificate: err = %v, want %q", err, unsupportedCurveError)
+		}
+		if _, err := ParseCertificateRequest(csrDER); err == nil || err.Error() != unsupportedCurveError {
+			t.Errorf("ParseCertificateRequest: err = %v, want %q", err, unsupportedCurveError)
+		}
+		if n := count() - before; n != 2 {
+			t.Errorf("%s increased by %d, want 2", name, n)
+		}
+		// Keys on supported curves don't count.
+		before = count()
+		if _, err := ParseCertificate(root.Raw); err != nil {
+			t.Errorf("ParseCertificate(P-256 root): %v", err)
+		}
+		if n := count() - before; n != 0 {
+			t.Errorf("%s increased by %d for a P-256 certificate, want 0", name, n)
+		}
+	})
+}
