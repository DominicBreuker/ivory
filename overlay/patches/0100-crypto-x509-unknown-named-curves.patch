+		{"missing parameters", nil},
+		{"implicitCurve (NULL)", []byte{0x05, 0x00}},
+		{"specifiedCurve (SEQUENCE)", []byte{0x30, 0x03, 0x02, 0x01, 0x01}},
+		{"INTEGER", []byte{0x02, 0x01, 0x07}},
+		{"empty OID", []byte{0x06, 0x00}},
+		{"truncated OID", []byte{0x06, 0x02, 0x2b, 0x84}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			der := createCertificateWithSPKI(t, unsupportedCurveTemplate("leaf", 2, false), root, spki(tt.params), rootKey)
+			_, err := ParseCertificate(der)
+			if tt.name == "named curve" {
+				if err != nil {
+					t.Fatalf("ParseCertificate: %v", err)
+				}
+				return
+			}
+			if err == nil {
+				t.Fatal("ParseCertificate succeeded, want an error")
+			}
+			if err.Error() == unsupportedCurveError {
+				t.Errorf("ParseCertificate: err = %v, want a parameter error", err)
+			}
