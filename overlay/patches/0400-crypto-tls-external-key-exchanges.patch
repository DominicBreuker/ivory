+// externalKeyExchange is a TLS 1.3 key share group from Config.KeyExchanges.
+type externalKeyExchange struct {
+	ke *KeyExchange
+}
+
+func (e *externalKeyExchange) keyShares(_ io.Reader) (*keySharePrivateKeys, []keyShare, error) {
+	priv, err := e.ke.GenerateKey()
+	if err != nil {
+		return nil, nil, err
+	}
+	return &keySharePrivateKeys{external: priv}, []keyShare{{e.ke.ID, priv.Encapsulator().Bytes()}}, nil
+}
+
+func (e *externalKeyExchange) serverSharedSecret(_ io.Reader, clientKeyShare []byte) ([]byte, keyShare, error) {
+	peerKey, err := e.ke.NewEncapsulator(clientKeyShare)
+	if err != nil {
+		return nil, keyShare{}, err
+	}
+	sharedKey, ciphertext := peerKey.Encapsulate()
+	return sharedKey, keyShare{e.ke.ID, ciphertext}, nil
+}
+
+func (e *externalKeyExchange) clientSharedSecret(priv *keySharePrivateKeys, serverKeyShare []byte) ([]byte, error) {
+	if priv.external == nil {
+		return nil, errors.New("tls: internal error: no key for the external key exchange")
+	}
+	return priv.external.Decapsulate(serverKeyShare)
+}
