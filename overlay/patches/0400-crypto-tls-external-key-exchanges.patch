diff --git a/src/crypto/tls/key_exchange_test.go b/src/crypto/tls/key_exchange_test.go
new file mode 100644
--- /dev/null
+++ b/src/crypto/tls/key_exchange_test.go
@@ -0,0 +1,553 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls
+
+import (
+	"crypto"
+	"crypto/ecdh"
+	"crypto/rand"
+	"errors"
+	"slices"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+// Private-use group IDs (RFC 8446, Section 4.2.7) for the test KEMs.
+const (
+	testGroupP256   CurveID = 0xFE01
+	testGroupX25519 CurveID = 0xFE02
+)
+
+// ecdhDecapsulator and ecdhEncapsulator model (EC)DH as a KEM, as
+// KeyExchange describes: the ciphertext is the peer's ephemeral public key.
+type ecdhDecapsulator struct{ key *ecdh.PrivateKey }
+
+func (d ecdhDecapsulator) Encapsulator() crypto.Encapsulator {
+	return ecdhEncapsulator{d.key.PublicKey()}
+}
+
+func (d ecdhDecapsulator) Decapsulate(ciphertext []byte) ([]byte, error) {
+	peer, err := d.key.Curve().NewPublicKey(ciphertext)
+	if err != nil {
+		return nil, err
+	}
+	return d.key.ECDH(peer)
+}
+
+type ecdhEncapsulator struct{ pub *ecdh.PublicKey }
+
+func (e ecdhEncapsulator) Bytes() []byte { return e.pub.Bytes() }
+
+func (e ecdhEncapsulator) Encapsulate() (sharedKey, ciphertext []byte) {
+	key, err := e.pub.Curve().GenerateKey(rand.Reader)
+	if err != nil {
+		panic(err)
+	}
+	sharedKey, err = key.ECDH(e.pub)
+	if err != nil {
+		panic(err)
+	}
+	return sharedKey, key.PublicKey().Bytes()
+}
+
+// testKEM is a KeyExchange for id, implemented with curve, that counts how
+// often it is used.
+type testKEM struct {
+	generated, encapsulated atomic.Int32
+}
+
+func (k *testKEM) keyExchange(id CurveID, curve ecdh.Curve) KeyExchange {
+	return KeyExchange{
+		ID: id,
+		GenerateKey: func() (crypto.Decapsulator, error) {
+			k.generated.Add(1)
+			key, err := curve.GenerateKey(rand.Reader)
+			if err != nil {
+				return nil, err
+			}
+			return ecdhDecapsulator{key}, nil
+		},
+		NewEncapsulator: func(encapsulationKey []byte) (crypto.Encapsulator, error) {
+			k.encapsulated.Add(1)
+			pub, err := curve.NewPublicKey(encapsulationKey)
+			if err != nil {
+				return nil, err
+			}
+			return ecdhEncapsulator{pub}, nil
+		},
+	}
+}
+
+// recordClientHello makes config record the supported_groups of the
+// ClientHellos it receives.
+func recordClientHello(config *Config) *[]CurveID {
+	var groups []CurveID
+	config.GetConfigForClient = func(chi *ClientHelloInfo) (*Config, error) {
+		groups = slices.Clone(chi.SupportedCurves)
+		return nil, nil
+	}
+	return &groups
+}
+
+func TestKeyExchangeTLS12(t *testing.T) {
+	var kem testKEM
+	ke := kem.keyExchange(testGroupP256, ecdh.P256())
+	clientConfig := testConfigClient.Clone()
+	clientConfig.MaxVersion = VersionTLS12
+	clientConfig.KeyExchanges = []KeyExchange{ke}
+	clientConfig.CurvePreferences = []CurveID{testGroupP256}
+	serverConfig := testConfigServer.Clone()
+	serverConfig.KeyExchanges = []KeyExchange{ke}
+	serverConfig.CurvePreferences = []CurveID{testGroupP256}
+	groups := recordClientHello(serverConfig)
+
+	ss, cs, err := testHandshake(t, clientConfig, serverConfig)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ss.CurveID != testGroupP256 || cs.CurveID != testGroupP256 {
+		t.Errorf("CurveID = %v (server), %v (client); want %v", ss.CurveID, cs.CurveID, testGroupP256)
+	}
+	if !slices.Equal(*groups, []CurveID{testGroupP256}) {
+		t.Errorf("supported_groups = %v, want [%v]", *groups, testGroupP256)
+	}
+	if g, e := kem.generated.Load(), kem.encapsulated.Load(); g != 1 || e != 1 {
