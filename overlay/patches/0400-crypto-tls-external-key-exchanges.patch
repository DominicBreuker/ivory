+// keyExchangeForCurveID is like the function keyExchangeForCurveID, but
+// also returns the TLS 1.3 groups of c.KeyExchanges.
+func (c *Config) keyExchangeForCurveID(id CurveID) (keyExchange, error) {
+	if ke := c.keyExchange(VersionTLS13, id); ke != nil {
+		return &externalKeyExchange{ke}, nil
+	}
