+// A KeyExchange is a key exchange group implemented outside this package,
+// for use in [Config.KeyExchanges]. It is used as an (EC)DHE group in
+// TLS 1.2 and as a key share group in TLS 1.3, modeled as a KEM: the side
+// that sends first (the server in TLS 1.2, the client in TLS 1.3) calls
+// GenerateKey and sends Encapsulator().Bytes(); the peer passes those bytes
+// to NewEncapsulator, calls Encapsulate and sends the ciphertext; the first
+// side calls Decapsulate. For elliptic curve Diffie-Hellman, the
+// encapsulation key and the ciphertext are the two ephemeral public keys,
+// and the shared key is the x-coordinate of the shared point, big-endian,
+// padded to the field size (RFC 8422, Section 5.10; RFC 8446,
+// Section 7.4.2).
+type KeyExchange struct {
+	ID CurveID
+
+	// MinVersion and MaxVersion limit the protocol versions for which ID
+	// is offered and accepted. Zero means no limit.
+	MinVersion, MaxVersion uint16
+
+	// GenerateKey returns a new ephemeral key for one handshake.
+	GenerateKey func() (crypto.Decapsulator, error)
+
+	// NewEncapsulator parses and validates the peer's encapsulation key.
+	NewEncapsulator func(encapsulationKey []byte) (crypto.Encapsulator, error)
+}
+
+// keyExchange returns the entry of c.KeyExchanges for id that may be used
+// at version, or nil.
+func (c *Config) keyExchange(version uint16, id CurveID) *KeyExchange {
+	if c == nil || len(c.KeyExchanges) == 0 ||
+		fips140tls.Required() || slices.Contains(curvePreferenceOrder(), id) {
+		return nil
+	}
+	for i := range c.KeyExchanges {
+		ke := &c.KeyExchanges[i]
+		if ke.ID == id && (ke.MinVersion == 0 || version >= ke.MinVersion) &&
+			(ke.MaxVersion == 0 || version <= ke.MaxVersion) {
+			return ke
+		}
+	}
+	return nil
+}
+
+// checkKeyExchanges reports an error if c.KeyExchanges is invalid.
+func (c *Config) checkKeyExchanges() error {
+	versions := func(ke KeyExchange) (lo, hi uint16) {
+		lo, hi = ke.MinVersion, ke.MaxVersion
+		if hi == 0 {
+			hi = 0xffff
+		}
+		return lo, hi
+	}
+	for i, ke := range c.KeyExchanges {
+		if slices.Contains(curvePreferenceOrder(), ke.ID) {
+			return fmt.Errorf("tls: KeyExchanges entry for built-in group %v", ke.ID)
+		}
+		if ke.GenerateKey == nil || ke.NewEncapsulator == nil {
+			return fmt.Errorf("tls: KeyExchanges entry for %v has nil functions", ke.ID)
+		}
+		lo, hi := versions(ke)
+		for _, prev := range c.KeyExchanges[:i] {
+			prevLo, prevHi := versions(prev)
+			if prev.ID == ke.ID && max(lo, prevLo) <= min(hi, prevHi) {
+				return fmt.Errorf("tls: KeyExchanges has two entries for %v with overlapping versions", ke.ID)
+			}
+		}
+	}
+	return nil
+}
