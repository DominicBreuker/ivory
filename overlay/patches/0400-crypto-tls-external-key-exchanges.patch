+func TestKeyExchangeTLS13(t *testing.T) {
+	t.Run("key share", func(t *testing.T) {
+		// A client whose CurvePreferences lists only external groups
+		// sends a key share for the first one.
+		var kem testKEM
+		ke := kem.keyExchange(testGroupP256, ecdh.P256())
+		clientConfig := testConfigClient.Clone()
+		clientConfig.KeyExchanges = []KeyExchange{ke}
+		clientConfig.CurvePreferences = []CurveID{testGroupP256}
+		serverConfig := testConfigServer.Clone()
+		serverConfig.KeyExchanges = []KeyExchange{ke}
+		ss, cs, err := testHandshake(t, clientConfig, serverConfig)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if ss.Version != VersionTLS13 || ss.CurveID != testGroupP256 || cs.CurveID != testGroupP256 {
+			t.Errorf("Version, CurveID = %x, %v (server), %v (client); want TLS 1.3, %v", ss.Version, ss.CurveID, cs.CurveID, testGroupP256)
+		}
+		if ss.HelloRetryRequest || cs.HelloRetryRequest {
+			t.Error("unexpected HelloRetryRequest")
+		}
+		if g, e := kem.generated.Load(), kem.encapsulated.Load(); g != 1 || e != 1 {
+			t.Errorf("GenerateKey ran %d times, NewEncapsulator %d times; want 1, 1", g, e)
+		}
+		// Each handshake uses a fresh key.
+		if _, _, err := testHandshake(t, clientConfig, serverConfig); err != nil {
+			t.Fatal(err)
+		}
+		if g := kem.generated.Load(); g != 2 {
+			t.Errorf("GenerateKey ran %d times after two handshakes, want 2", g)
+		}
+	})
+
+	t.Run("HelloRetryRequest", func(t *testing.T) {
+		// The client sends a key share for a built-in group; the server
+		// accepts only the external group and asks for it.
+		var kem testKEM
+		ke := kem.keyExchange(testGroupX25519, ecdh.X25519())
+		clientConfig := testConfigClient.Clone()
+		clientConfig.KeyExchanges = []KeyExchange{ke}
+		serverConfig := testConfigServer.Clone()
+		serverConfig.KeyExchanges = []KeyExchange{ke}
+		serverConfig.CurvePreferences = []CurveID{testGroupX25519}
+		ss, cs, err := testHandshake(t, clientConfig, serverConfig)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if ss.CurveID != testGroupX25519 || cs.CurveID != testGroupX25519 {
+			t.Errorf("CurveID = %v (server), %v (client); want %v", ss.CurveID, cs.CurveID, testGroupX25519)
+		}
+		if !ss.HelloRetryRequest || !cs.HelloRetryRequest {
+			t.Error("no HelloRetryRequest")
+		}
+		if g, e := kem.generated.Load(), kem.encapsulated.Load(); g != 1 || e != 1 {
+			t.Errorf("GenerateKey ran %d times, NewEncapsulator %d times; want 1, 1", g, e)
+		}
+	})
+
+	t.Run("HelloRetryRequest for a TLS 1.2 group", func(t *testing.T) {
+		// A server that selects a group the client offered only for
+		// TLS 1.2 gets illegal_parameter. The server here is wrong to
+		// use the group in TLS 1.3.
+		var kem testKEM
+		ke := kem.keyExchange(testGroupP256, ecdh.P256())
+		ke12 := ke
+		ke12.MaxVersion = VersionTLS12
+		clientConfig := testConfigClient.Clone()
+		clientConfig.KeyExchanges = []KeyExchange{ke12}
+		serverConfig := testConfigServer.Clone()
+		serverConfig.KeyExchanges = []KeyExchange{ke}
+		serverConfig.CurvePreferences = []CurveID{testGroupP256}
+		clientErr, serverErr := fipsHandshake(t, clientConfig, serverConfig)
+		if clientErr == nil || !strings.Contains(clientErr.Error(), "server selected unsupported group") {
+			t.Errorf("client error = %v, want an unsupported group error", clientErr)
+		}
+		if serverErr == nil || !strings.Contains(serverErr.Error(), "illegal parameter") {
+			t.Errorf("server error = %v, want an illegal_parameter alert", serverErr)
+		}
+	})
+}
