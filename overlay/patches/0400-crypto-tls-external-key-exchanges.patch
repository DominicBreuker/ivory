+func TestKeyExchangeVersions(t *testing.T) {
+	var kem12, kem13 testKEM
+	ke12 := kem12.keyExchange(testGroupP256, ecdh.P256())
+	ke12.MaxVersion = VersionTLS12
+	ke13 := kem13.keyExchange(testGroupX25519, ecdh.X25519())
+	ke13.MinVersion = VersionTLS13
+	kes := []KeyExchange{ke12, ke13}
+
+	t.Run("TLS 1.2", func(t *testing.T) {
+		clientConfig := testConfigClient.Clone()
+		clientConfig.MaxVersion = VersionTLS12
+		clientConfig.KeyExchanges = kes
+		clientConfig.CurvePreferences = []CurveID{testGroupP256, testGroupX25519}
+		serverConfig := testConfigServer.Clone()
+		serverConfig.KeyExchanges = kes
+		groups := recordClientHello(serverConfig)
+		ss, _, err := testHandshake(t, clientConfig, serverConfig)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if want := []CurveID{testGroupP256}; !slices.Equal(*groups, want) {
+			t.Errorf("supported_groups = %v, want %v", *groups, want)
+		}
+		if ss.CurveID != testGroupP256 {
+			t.Errorf("CurveID = %v, want %v", ss.CurveID, testGroupP256)
+		}
+	})
+
+	t.Run("TLS 1.2 server, TLS 1.3 group", func(t *testing.T) {
+		clientConfig := testConfigClient.Clone()
+		clientConfig.MaxVersion = VersionTLS12
+		clientConfig.KeyExchanges = kes
+		clientConfig.CurvePreferences = []CurveID{testGroupP256}
+		serverConfig := testConfigServer.Clone()
+		serverConfig.KeyExchanges = kes
+		serverConfig.CurvePreferences = []CurveID{testGroupX25519}
+		if _, _, err := testHandshake(t, clientConfig, serverConfig); err == nil {
+			t.Fatal("handshake succeeded without a common TLS 1.2 group")
+		}
+		if n := kem13.generated.Load() + kem13.encapsulated.Load(); n != 0 {
+			t.Errorf("the TLS 1.3 group was used %d times in TLS 1.2", n)
+		}
+	})
+
+	t.Run("client offers TLS 1.2 and 1.3", func(t *testing.T) {
+		// Both groups are offered, the TLS 1.2 group after the TLS 1.3
+		// group, and a server that negotiates TLS 1.2 uses the TLS 1.2
+		// group.
+		clientConfig := testConfigClient.Clone()
+		clientConfig.KeyExchanges = kes
+		serverConfig := testConfigServer.Clone()
+		serverConfig.MaxVersion = VersionTLS12
+		serverConfig.KeyExchanges = kes
+		serverConfig.CurvePreferences = []CurveID{testGroupP256}
+		groups := recordClientHello(serverConfig)
+		ss, _, err := testHandshake(t, clientConfig, serverConfig)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if ss.Version != VersionTLS12 || ss.CurveID != testGroupP256 {
+			t.Errorf("Version, CurveID = %x, %v; want TLS 1.2, %v", ss.Version, ss.CurveID, testGroupP256)
+		}
+		if n := len(*groups); n < 2 || (*groups)[n-2] != testGroupX25519 || (*groups)[n-1] != testGroupP256 {
+			t.Errorf("supported_groups = %v, want %v and %v last", *groups, testGroupX25519, testGroupP256)
+		}
+	})
+
+	t.Run("TLS 1.3", func(t *testing.T) {
+		// Built-in groups come first.
+		clientConfig := testConfigClient.Clone()
+		clientConfig.KeyExchanges = kes
+		serverConfig := testConfigServer.Clone()
+		serverConfig.KeyExchanges = kes
+		ss, _, err := testHandshake(t, clientConfig, serverConfig)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if ss.Version != VersionTLS13 || ss.CurveID == testGroupP256 || ss.CurveID == testGroupX25519 {
+			t.Errorf("Version, CurveID = %x, %v; want TLS 1.3 with a built-in group", ss.Version, ss.CurveID)
+		}
+	})
+
+	t.Run("TLS 1.3 server, TLS 1.2 group", func(t *testing.T) {
+		clientConfig := testConfigClient.Clone()
+		clientConfig.KeyExchanges = kes
+		clientConfig.CurvePreferences = []CurveID{testGroupP256, testGroupX25519}
+		serverConfig := testConfigServer.Clone()
+		serverConfig.KeyExchanges = kes
+		serverConfig.CurvePreferences = []CurveID{testGroupP256}
+		_, _, err := testHandshake(t, clientConfig, serverConfig)
+		if err == nil || !strings.Contains(err.Error(), "no key exchanges supported") {
+			t.Errorf("err = %v, want no common TLS 1.3 group", err)
+		}
+	})
+
+	t.Run("only TLS 1.2 groups", func(t *testing.T) {
+		// A client without a TLS 1.3 group doesn't offer TLS 1.3.
+		clientConfig := testConfigClient.Clone()
+		clientConfig.KeyExchanges = kes
+		clientConfig.CurvePreferences = []CurveID{testGroupP256}
+		serverConfig := testConfigServer.Clone()
+		serverConfig.KeyExchanges = kes
+		ss, _, err := testHandshake(t, clientConfig, serverConfig)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if ss.Version != VersionTLS12 || ss.CurveID != testGroupP256 {
+			t.Errorf("Version, CurveID = %x, %v; want TLS 1.2, %v", ss.Version, ss.CurveID, testGroupP256)
+		}
+	})
+}
