+func TestOpaqueKeySupportsCertificate(t *testing.T) {
+	opaqueCert, _, pool := opaqueKeyCertificate(t, "example.golang", ECDSAWithP256AndSHA256)
+	otherCert, _, _ := opaqueKeyCertificate(t, "other.example", ECDSAWithP256AndSHA256)
+	noSchemes := opaqueCert
+	noSchemes.SupportedSignatureAlgorithms = nil
+	mixed := opaqueCert
+	mixed.SupportedSignatureAlgorithms = []SignatureScheme{ECDSAWithP256AndSHA256, PKCS1WithSHA256}
+	ed := opaqueCert
+	ed.SupportedSignatureAlgorithms = []SignatureScheme{Ed25519}
+	unknownOnly := opaqueCert
+	unknownOnly.SupportedSignatureAlgorithms = []SignatureScheme{0xfe01}
+	msgCert := opaqueCert
+	msgCert.PrivateKey = &opaqueMessageSigner{opaqueSigner: opaqueCert.PrivateKey.(*opaqueSigner)}
+	msgCert.SupportedSignatureAlgorithms = []SignatureScheme{ECDSAWithP256AndSHA256, testSchemeUnimplemented}
+
+	chi := func(versions []uint16, curves []CurveID, schemes []SignatureScheme) *ClientHelloInfo {
+		return &ClientHelloInfo{
+			CipherSuites:      []uint16{TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256},
+			SupportedCurves:   curves,
+			SupportedPoints:   []uint8{pointFormatUncompressed},
+			SignatureSchemes:  schemes,
+			SupportedVersions: versions,
+			config:            &Config{},
+		}
+	}
+	tls12 := []uint16{VersionTLS12}
+	for _, tt := range []struct {
+		name    string
+		cert    *Certificate
+		chi     *ClientHelloInfo
+		wantErr string
+	}{
+		{"TLS 1.2", &opaqueCert, chi(tls12, []CurveID{CurveP256}, []SignatureScheme{ECDSAWithP256AndSHA256}), ""},
+		// The curve of an opaque key is unknown, so it is not checked
+		// against supported_groups. A P-256 key would fail here.
+		{"curve not checked", &opaqueCert, chi(tls12, []CurveID{X25519}, []SignatureScheme{ECDSAWithP256AndSHA256}), ""},
+		{"no common scheme", &opaqueCert, chi(tls12, []CurveID{CurveP256}, []SignatureScheme{ECDSAWithP384AndSHA384}), "doesn't support any of the certificate's signature algorithms"},
+		{"no RSA fallback", &opaqueCert, chi(tls12, []CurveID{CurveP256}, []SignatureScheme{PKCS1WithSHA256}), "doesn't support any of the certificate's signature algorithms"},
+		{"TLS 1.3 without MessageSigner", &opaqueCert, chi([]uint16{VersionTLS13}, []CurveID{CurveP256}, []SignatureScheme{ECDSAWithP256AndSHA256, testSchemeUnimplemented}), "must implement crypto.MessageSigner"},
+		{"TLS 1.3", &msgCert, chi([]uint16{VersionTLS13}, []CurveID{X25519}, []SignatureScheme{testSchemeUnimplemented}), ""},
+		// In TLS 1.3, ECDSAWithP256AndSHA256 is bound to P-256 keys.
+		{"TLS 1.3 implemented scheme", &msgCert, chi([]uint16{VersionTLS13}, []CurveID{X25519}, []SignatureScheme{ECDSAWithP256AndSHA256}), "doesn't support any of the certificate's signature algorithms"},
+		{"no SupportedSignatureAlgorithms", &noSchemes, chi(tls12, []CurveID{CurveP256}, []SignatureScheme{ECDSAWithP256AndSHA256}), "SupportedSignatureAlgorithms is empty"},
+		{"ECDSA and RSA mixed", &mixed, chi(tls12, []CurveID{CurveP256}, []SignatureScheme{ECDSAWithP256AndSHA256}), "mixes ECDSA and RSA"},
+		{"Ed25519", &ed, chi(tls12, []CurveID{CurveP256}, []SignatureScheme{Ed25519}), "can't be used with a certificate key"},
+		{"only unknown schemes", &unknownOnly, chi(tls12, []CurveID{CurveP256}, []SignatureScheme{ECDSAWithP256AndSHA256}), "no signature algorithm known"},
+	} {
+		t.Run("ClientHelloInfo/"+tt.name, func(t *testing.T) {
+			err := tt.chi.SupportsCertificate(tt.cert)
+			if tt.wantErr == "" {
+				if err != nil {
+					t.Errorf("SupportsCertificate: %v", err)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+				t.Errorf("SupportsCertificate: err = %v, want %q", err, tt.wantErr)
+			}
+		})
+	}
+
+	// A P-256 key of the same certificate fails the curve check that is
+	// skipped for the opaque key.
+	p256Cert := opaqueCert
+	p256Cert.PrivateKey = opaqueCert.PrivateKey.(*opaqueSigner).signer
+	if err := chi(tls12, []CurveID{X25519}, []SignatureScheme{ECDSAWithP256AndSHA256}).SupportsCertificate(&p256Cert); err == nil {
+		t.Error("SupportsCertificate accepted a P-256 key without P-256 in supported_groups")
+	}
+
+	// Client certificates: the signature schemes and the acceptable CAs.
+	issuer := func(c Certificate) []byte {
+		x, err := x509.ParseCertificate(c.Certificate[0])
+		if err != nil {
+			t.Fatal(err)
+		}
+		return x.RawIssuer
+	}
+	for _, tt := range []struct {
+		name    string
+		cri     *CertificateRequestInfo
+		wantErr string
+	}{
+		{"no acceptable CAs", &CertificateRequestInfo{Version: VersionTLS12, SignatureSchemes: []SignatureScheme{ECDSAWithP256AndSHA256}}, ""},
+		{"acceptable CA", &CertificateRequestInfo{Version: VersionTLS12, SignatureSchemes: []SignatureScheme{ECDSAWithP256AndSHA256}, AcceptableCAs: [][]byte{issuer(opaqueCert)}}, ""},
+		{"other CA", &CertificateRequestInfo{Version: VersionTLS12, SignatureSchemes: []SignatureScheme{ECDSAWithP256AndSHA256}, AcceptableCAs: [][]byte{issuer(otherCert)}}, "not signed by an acceptable CA"},
+		{"RSA schemes only", &CertificateRequestInfo{Version: VersionTLS12, SignatureSchemes: []SignatureScheme{PKCS1WithSHA256, PSSWithSHA256}}, "doesn't support any"},
+		{"TLS 1.3 without MessageSigner", &CertificateRequestInfo{Version: VersionTLS13, SignatureSchemes: []SignatureScheme{testSchemeUnimplemented}}, "must implement crypto.MessageSigner"},
+	} {
+		t.Run("CertificateRequestInfo/"+tt.name, func(t *testing.T) {
+			err := tt.cri.SupportsCertificate(&opaqueCert)
+			if tt.wantErr == "" {
+				if err != nil {
+					t.Errorf("SupportsCertificate: %v", err)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+				t.Errorf("SupportsCertificate: err = %v, want %q", err, tt.wantErr)
+			}
+		})
+	}
+
+	// In a handshake, a client sends the certificate only if the server
+	// accepts its CA.
+	for _, tt := range []struct {
+		name     string
+		cas      *x509.CertPool
+		wantSent bool
+	}{
+		{"acceptable CA", pool, true},
+		{"other CA", x509.NewCertPool(), false},
+	} {
+		t.Run("handshake/"+tt.name, func(t *testing.T) {
+			if !tt.wantSent {
+				_, _, otherPool := opaqueKeyCertificate(t, "unrelated.example", ECDSAWithP256AndSHA256)
+				tt.cas = otherPool
+			}
+			serverConfig := testConfigServer.Clone()
+			serverConfig.MaxVersion = VersionTLS12
+			serverConfig.ClientAuth = RequestClientCert
+			serverConfig.ClientCAs = tt.cas
+			clientConfig := testConfigClient.Clone()
+			clientConfig.Certificates = []Certificate{opaqueCert}
+			ss, _, err := testHandshake(t, clientConfig, serverConfig)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if sent := len(ss.PeerCertificates) > 0; sent != tt.wantSent {
+				t.Errorf("client sent a certificate: %v, want %v", sent, tt.wantSent)
+			}
+		})
+	}
+}
