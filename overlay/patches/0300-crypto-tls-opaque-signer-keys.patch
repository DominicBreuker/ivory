+
+// testSchemeUnimplemented is a private-use signature scheme (RFC 8446,
+// Section 4.2.3), so this package doesn't implement it. In these tests it
+// stands for ECDSA with a P-256 key and SHA-256, like a TLS 1.3 scheme for
+// a curve this package doesn't support.
+const testSchemeUnimplemented SignatureScheme = 0xfe01
+
+// opaqueMessageSigner is an opaqueSigner that also implements
+// crypto.MessageSigner, which TLS 1.3 requires, and can sign with
+// testSchemeUnimplemented.
+type opaqueMessageSigner struct {
+	*opaqueSigner
+
+	mu   sync.Mutex
+	opts []crypto.SignerOpts // the opts of every SignMessage call
+	msgs [][]byte            // the msg of every SignMessage call
+}
+
+func (s *opaqueMessageSigner) SignMessage(rand io.Reader, msg []byte, opts crypto.SignerOpts) ([]byte, error) {
+	s.mu.Lock()
+	s.opts = append(s.opts, opts)
+	s.msgs = append(s.msgs, bytes.Clone(msg))
+	s.mu.Unlock()
+	o, ok := opts.(*SignatureSchemeOptions)
+	if !ok {
+		return crypto.SignMessage(s.opaqueSigner, rand, msg, opts)
+	}
+	if o.Scheme != testSchemeUnimplemented {
+		return nil, errors.New("unexpected signature scheme")
+	}
+	h := sha256.Sum256(msg)
+	return s.opaqueSigner.Sign(rand, h[:], crypto.SHA256)
+}
+
+// verifyTestScheme is a Config.VerifyUnsupportedSignature for certificates
+// made by unsupportedKeyCertificate that accepts testSchemeUnimplemented.
+func verifyTestScheme(leaf *x509.Certificate, scheme SignatureScheme, signed, sig []byte) error {
+	if scheme != testSchemeUnimplemented {
+		return errors.New("unexpected signature scheme")
+	}
+	return verifyUnsupportedCurveSignature(leaf, ECDSAWithP256AndSHA256, signed, sig)
+}
+
+// advertiseTestScheme makes this package advertise testSchemeUnimplemented
+// after its default signature algorithms until the test ends.
+func advertiseTestScheme(t *testing.T) {
+	saved := testingOnlySupportedSignatureAlgorithms
+	testingOnlySupportedSignatureAlgorithms = append(defaultSupportedSignatureAlgorithms(), testSchemeUnimplemented)
+	t.Cleanup(func() { testingOnlySupportedSignatureAlgorithms = saved })
+}
+
+// unimplementedSchemeCertificate returns a certificate whose key this
+// package doesn't support (see unsupportedKeyCertificate) and whose
+// PrivateKey is an opaqueMessageSigner with the given schemes, and a pool
+// with its CA.
+func unimplementedSchemeCertificate(t *testing.T, cn string, schemes ...SignatureScheme) (Certificate, *opaqueMessageSigner, *x509.CertPool) {
+	cert, pool := unsupportedKeyCertificate(t, cn)
+	signer := &opaqueMessageSigner{opaqueSigner: &opaqueSigner{signer: cert.PrivateKey.(crypto.Signer)}}
+	cert.PrivateKey = signer
+	cert.SupportedSignatureAlgorithms = schemes
+	return cert, signer, pool
+}
+
+// TestOpaqueKeyTLS13 checks that in TLS 1.3 an opaque key signs with a
+// scheme this package doesn't implement, through SignMessage with the
+// unhashed content and SignatureSchemeOptions, and that the peer passes the
+// same content to Config.VerifyUnsupportedSignature.
+func TestOpaqueKeyTLS13(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		client  bool // whether the opaque key is the client's
+		context string
+	}{
+		{"server", false, serverSignatureContext},
+		{"client", true, clientSignatureContext},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			advertiseTestScheme(t)
+			cert, signer, pool := unimplementedSchemeCertificate(t, tt.name+".example", ECDSAWithP256AndSHA256, testSchemeUnimplemented)
+			var signed [][]byte
+			hook := func(leaf *x509.Certificate, scheme SignatureScheme, s, sig []byte) error {
+				signed = append(signed, bytes.Clone(s))
+				return verifyTestScheme(leaf, scheme, s, sig)
+			}
+			serverConfig := testConfigServer.Clone()
+			clientConfig := testConfigClient.Clone()
+			clientConfig.InsecureSkipVerify = true
+			if tt.client {
+				clientConfig.Certificates = []Certificate{cert}
+				serverConfig.ClientAuth = RequireAnyClientCert
+				serverConfig.ClientCAs = pool // sent as the acceptable CAs
+				serverConfig.VerifyUnsupportedSignature = hook
+			} else {
+				serverConfig.Certificates = []Certificate{cert}
+				clientConfig.VerifyUnsupportedSignature = hook
+			}
+			ss, cs, err := testHandshake(t, clientConfig, serverConfig)
+			if err != nil {
+				t.Fatal(err)
+			}
+			peer := cs
+			if tt.client {
+				peer = ss
+			}
+			if peer.Version != VersionTLS13 {
+				t.Errorf("version = %x, want TLS 1.3", peer.Version)
+			}
+			if peer.testingOnlyPeerSignatureAlgorithm != testSchemeUnimplemented {
+				t.Errorf("signature algorithm = %v, want %v", peer.testingOnlyPeerSignatureAlgorithm, testSchemeUnimplemented)
+			}
+			if h := signer.signHashes(); len(h) != 1 || h[0] != crypto.SHA256 {
+				t.Errorf("Sign called with hashes %v, want [SHA-256]", h)
+			}
+			signer.mu.Lock()
+			defer signer.mu.Unlock()
+			if len(signer.opts) != 1 || len(signed) != 1 {
+				t.Fatalf("SignMessage called %d times, hook called %d times; want 1 and 1", len(signer.opts), len(signed))
+			}
+			if o, ok := signer.opts[0].(*SignatureSchemeOptions); !ok || o.Scheme != testSchemeUnimplemented || o.HashFunc() != 0 {
+				t.Errorf("SignMessage opts = %#v, want &SignatureSchemeOptions{Scheme: %v}", signer.opts[0], testSchemeUnimplemented)
+			}
+			if !bytes.Equal(signer.msgs[0], signed[0]) {
+				t.Error("the signer and the hook got different messages")
+			}
+			prefix := append(bytes.Repeat([]byte{0x20}, 64), tt.context...)
+			if !bytes.HasPrefix(signed[0], prefix) || len(signed[0]) != len(prefix)+32 {
+				t.Errorf("signed content = %q, want %q and a SHA-256 transcript hash", signed[0], prefix)
+			}
+		})
+	}
+}
