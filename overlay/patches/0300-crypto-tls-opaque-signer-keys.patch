+func TestOpaqueKeyTLS13Errors(t *testing.T) {
+	for _, tt := range []struct {
+		name      string
+		schemes   []SignatureScheme
+		advertise bool
+		serverErr string
+	}{
+		{"only implemented schemes", []SignatureScheme{ECDSAWithP256AndSHA256}, true, "no TLS 1.3 signature algorithm"},
+		{"scheme not advertised", []SignatureScheme{testSchemeUnimplemented}, false, "peer doesn't support any of the certificate's signature algorithms"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.advertise {
+				advertiseTestScheme(t)
+			}
+			cert, _, _ := unimplementedSchemeCertificate(t, "server.example", tt.schemes...)
+			serverConfig := testConfigServer.Clone()
+			serverConfig.Certificates = []Certificate{cert}
+			clientConfig := testConfigClient.Clone()
+			clientConfig.InsecureSkipVerify = true
+			clientConfig.VerifyUnsupportedSignature = verifyTestScheme
+			clientErr, serverErr := fipsHandshake(t, clientConfig, serverConfig)
+			if clientErr == nil {
+				t.Error("handshake succeeded")
+			}
+			if serverErr == nil || !strings.Contains(serverErr.Error(), tt.serverErr) {
+				t.Errorf("server error = %v, want %q", serverErr, tt.serverErr)
+			}
+		})
+	}
+}
