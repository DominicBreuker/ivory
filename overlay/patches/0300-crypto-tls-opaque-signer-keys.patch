+// license that can be found in the LICENSE file.
+
+package tls
+
+import (
+	"bytes"
+	"crypto"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"errors"
+	"io"
+	"math/big"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// opaquePublicKey is a public key type that this package doesn't implement,
+// like the key of a hardware token on a curve crypto/ecdsa doesn't support.
+type opaquePublicKey struct {
+	raw []byte
+}
+
+// opaqueSigner is a crypto.Signer whose Public method returns an
+// opaquePublicKey. It signs with a wrapped key that this package would
+// support, so that peers can verify its signatures as usual.
+type opaqueSigner struct {
+	signer crypto.Signer
+
+	mu     sync.Mutex
+	hashes []crypto.Hash // the hash of every Sign call
+}
+
+func (s *opaqueSigner) Public() crypto.PublicKey {
+	return opaquePublicKey{raw: []byte("opaque")}
+}
+
+func (s *opaqueSigner) Sign(rand io.Reader, digest []byte, opts crypto.SignerOpts) ([]byte, error) {
+	s.mu.Lock()
+	s.hashes = append(s.hashes, opts.HashFunc())
+	s.mu.Unlock()
+	return s.signer.Sign(rand, digest, opts)
+}
+
+func (s *opaqueSigner) signHashes() []crypto.Hash {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return append([]crypto.Hash(nil), s.hashes...)
+}
+
+// opaqueKeyCertificate returns a P-256 certificate for cn, issued by a new
+// CA, whose PrivateKey is an opaqueSigner with the given schemes, and a pool
+// with the CA.
+func opaqueKeyCertificate(t *testing.T, cn string, schemes ...SignatureScheme) (Certificate, *opaqueSigner, *x509.CertPool) {
+	t.Helper()
+	caKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	caTmpl := &x509.Certificate{
+		SerialNumber:          big.NewInt(1),
+		Subject:               pkix.Name{CommonName: cn + " CA"},
+		NotBefore:             testTime().Add(-time.Hour),
+		NotAfter:              testTime().Add(time.Hour),
+		KeyUsage:              x509.KeyUsageCertSign,
+		BasicConstraintsValid: true,
+		IsCA:                  true,
+	}
+	caDER, err := x509.CreateCertificate(rand.Reader, caTmpl, caTmpl, caKey.Public(), caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ca, err := x509.ParseCertificate(caDER)
+	if err != nil {
+		t.Fatal(err)
+	}
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(2),
+		Subject:      pkix.Name{CommonName: cn},
+		DNSNames:     []string{cn},
+		NotBefore:    testTime().Add(-time.Hour),
+		NotAfter:     testTime().Add(time.Hour),
+		KeyUsage:     x509.KeyUsageDigitalSignature,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth, x509.ExtKeyUsageClientAuth},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, ca, key.Public(), caKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	signer := &opaqueSigner{signer: key}
+	pool := x509.NewCertPool()
+	pool.AddCert(ca)
+	return Certificate{
+		Certificate:                  [][]byte{der},
+		PrivateKey:                   signer,
+		SupportedSignatureAlgorithms: schemes,
+	}, signer, pool
+}
+
+func TestOpaqueKeyServer(t *testing.T) {
+	for _, tt := range []struct {
+		name       string
+		schemes    []SignatureScheme
+		wantScheme SignatureScheme
+		wantHash   crypto.Hash
+	}{
+		{"P256AndSHA256", []SignatureScheme{ECDSAWithP256AndSHA256}, ECDSAWithP256AndSHA256, crypto.SHA256},
+		// In TLS 1.2, ECDSA schemes are not bound to a curve.
+		{"P384AndSHA384", []SignatureScheme{ECDSAWithP384AndSHA384}, ECDSAWithP384AndSHA384, crypto.SHA384},
+		// Unknown schemes, for example for TLS 1.3, are ignored.
+		{"unknown scheme ignored", []SignatureScheme{0xfe01, ECDSAWithP521AndSHA512}, ECDSAWithP521AndSHA512, crypto.SHA512},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			cert, signer, pool := opaqueKeyCertificate(t, "server.example", tt.schemes...)
+			serverConfig := testConfigServer.Clone()
+			serverConfig.Certificates = []Certificate{cert}
+			serverConfig.MaxVersion = VersionTLS12
+			clientConfig := testConfigClient.Clone()
+			clientConfig.RootCAs = pool
+			clientConfig.ServerName = "server.example"
+			_, cs, err := testHandshake(t, clientConfig, serverConfig)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cs.Version != VersionTLS12 {
+				t.Errorf("version = %x, want TLS 1.2", cs.Version)
+			}
+			if cipherSuiteByID(cs.CipherSuite).flags&suiteECSign == 0 {
+				t.Errorf("cipher suite = %v, want an ECDHE_ECDSA suite", CipherSuiteName(cs.CipherSuite))
+			}
+			if cs.testingOnlyPeerSignatureAlgorithm != tt.wantScheme {
+				t.Errorf("signature algorithm = %v, want %v", cs.testingOnlyPeerSignatureAlgorithm, tt.wantScheme)
+			}
+			if h := signer.signHashes(); len(h) != 1 || h[0] != tt.wantHash {
+				t.Errorf("Sign called with hashes %v, want [%v]", h, tt.wantHash)
+			}
+		})
+	}
+}
+
+func TestOpaqueKeyClient(t *testing.T) {
+	cert, signer, pool := opaqueKeyCertificate(t, "client.example", ECDSAWithP256AndSHA256)
+	serverConfig := testConfigServer.Clone()
+	serverConfig.MaxVersion = VersionTLS12
+	serverConfig.ClientAuth = RequireAndVerifyClientCert
+	serverConfig.ClientCAs = pool
+	clientConfig := testConfigClient.Clone()
+	clientConfig.Certificates = []Certificate{cert}
+	ss, _, err := testHandshake(t, clientConfig, serverConfig)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ss.PeerCertificates) != 1 || ss.PeerCertificates[0].Subject.CommonName != "client.example" {
+		t.Errorf("server got peer certificates %v, want client.example", ss.PeerCertificates)
+	}
+	if ss.testingOnlyPeerSignatureAlgorithm != ECDSAWithP256AndSHA256 {
+		t.Errorf("signature algorithm = %v, want %v", ss.testingOnlyPeerSignatureAlgorithm, ECDSAWithP256AndSHA256)
+	}
+	if h := signer.signHashes(); len(h) != 1 || h[0] != crypto.SHA256 {
+		t.Errorf("Sign called with hashes %v, want [SHA-256]", h)
+	}
+}
