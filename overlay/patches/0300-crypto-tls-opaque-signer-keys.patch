+// isOpaquePublicKey reports whether pub is of a type that this package doesn't
+// implement. A Certificate with such a key signs with the schemes in its
+// SupportedSignatureAlgorithms.
+func isOpaquePublicKey(pub crypto.PublicKey) bool {
+	switch pub.(type) {
+	case *ecdsa.PublicKey, *rsa.PublicKey, ed25519.PublicKey, *mldsa.PublicKey:
+		return false
+	}
+	return true
+}
+
+// signsUnimplementedSchemes reports whether c may sign with signature schemes
+// that this package doesn't implement: its key must be a crypto.MessageSigner
+// whose public key is of a type this package doesn't implement. SignMessage
+// then gets the unhashed message and a *SignatureSchemeOptions.
+func signsUnimplementedSchemes(c *Certificate) bool {
+	ms, ok := c.PrivateKey.(crypto.MessageSigner)
+	return ok && isOpaquePublicKey(ms.Public())
+}
+
+// A SignatureSchemeOptions is the crypto.SignerOpts that this package passes
+// to [crypto.MessageSigner.SignMessage] when a key of a type this package
+// doesn't implement signs with a signature scheme that this package doesn't
+// implement (see [Certificate.SupportedSignatureAlgorithms]). The message is
+// not hashed: the signer applies the hash, if any, that Scheme defines.
+type SignatureSchemeOptions struct {
+	Scheme SignatureScheme
+}
+
+// HashFunc returns zero, since the message passed with SignatureSchemeOptions
+// is not hashed.
+func (*SignatureSchemeOptions) HashFunc() crypto.Hash { return 0 }
+
+// opaqueSignatureSchemes returns the signature schemes that c, a certificate
+// whose public key is of a type this package doesn't implement, can sign with
+// in a connection of version vers, and their signature type.
+//
+// In TLS 1.2, they are the schemes this package implements, and the type is
+// signatureECDSA, or signaturePKCS1v15 if they are RSA schemes (PKCS #1 v1.5
+// or RSA-PSS). In TLS 1.3, the schemes this package implements are bound to
+// public key types it implements (ECDSA schemes to a curve), so they are the
+// other schemes, and the type is zero.
+func opaqueSignatureSchemes(vers uint16, c *Certificate) ([]SignatureScheme, uint8, error) {
+	pub := c.PrivateKey.(crypto.Signer).Public()
+	if len(c.SupportedSignatureAlgorithms) == 0 {
+		return nil, 0, fmt.Errorf("tls: certificate key (%T) is not supported by this package, and Certificate.SupportedSignatureAlgorithms is empty", pub)
+	}
+	if vers < VersionTLS12 {
+		return nil, 0, fmt.Errorf("tls: certificate key (%T) is not supported by this package, and can only be used in TLS 1.2 and TLS 1.3", pub)
+	}
+	if fips140tls.Required() {
+		return nil, 0, fmt.Errorf("tls: certificate key (%T) is not supported in FIPS 140-3 mode", pub)
+	}
+	if vers == VersionTLS13 {
+		if !signsUnimplementedSchemes(c) {
+			return nil, 0, fmt.Errorf("tls: certificate key (%T) is not supported by this package, and must implement crypto.MessageSigner to be used in TLS 1.3", pub)
+		}
+		var schemes []SignatureScheme
+		for _, s := range c.SupportedSignatureAlgorithms {
+			if _, _, err := typeAndHashFromSignatureScheme(s); err != nil {
+				schemes = append(schemes, s)
+			}
+		}
+		if len(schemes) == 0 {
+			return nil, 0, fmt.Errorf("tls: Certificate.SupportedSignatureAlgorithms has no TLS 1.3 signature algorithm for a certificate key (%T) that is not supported by this package", pub)
+		}
+		return schemes, 0, nil
+	}
+	var schemes []SignatureScheme
+	var sigType uint8
+	for _, s := range c.SupportedSignatureAlgorithms {
+		t, _, err := typeAndHashFromSignatureScheme(s)
+		if err != nil {
+			continue
+		}
+		switch t {
+		case signatureECDSA:
+		case signaturePKCS1v15, signatureRSAPSS:
+			t = signaturePKCS1v15
+		default:
+			return nil, 0, fmt.Errorf("tls: signature algorithm %v can't be used with a certificate key (%T) that is not supported by this package", s, pub)
+		}
+		if sigType != 0 && t != sigType {
+			return nil, 0, errors.New("tls: Certificate.SupportedSignatureAlgorithms mixes ECDSA and RSA for a key that is not supported by this package")
+		}
+		sigType = t
+		schemes = append(schemes, s)
+	}
+	if len(schemes) == 0 {
+		return nil, 0, fmt.Errorf("tls: Certificate.SupportedSignatureAlgorithms has no signature algorithm known to this package for a certificate key (%T)", pub)
+	}
+	return schemes, sigType, nil
+}
