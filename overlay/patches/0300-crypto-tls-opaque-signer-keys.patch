+// TestOpaqueKeyCertificateSelection checks that a server with an RSA
+// certificate and a certificate with an opaque ECDSA key picks the one that
+// fits the cipher suites the client offers.
+func TestOpaqueKeyCertificateSelection(t *testing.T) {
+	// The certificates are valid for the client's server name.
+	opaqueCert, _, pool := opaqueKeyCertificate(t, "test.golang.example", ECDSAWithP256AndSHA256)
+	for _, tt := range []struct {
+		name       string
+		certs      []Certificate
+		suites     []uint16
+		wantSuite  uint16
+		wantOpaque bool
+	}{
+		{"ECDSA suites, RSA first", []Certificate{testRSA2048Cert, opaqueCert},
+			[]uint16{TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256}, TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, true},
+		{"RSA suites, opaque first", []Certificate{opaqueCert, testRSA2048Cert},
+			[]uint16{TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256}, TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, false},
+		{"both, opaque first", []Certificate{opaqueCert, testRSA2048Cert},
+			[]uint16{TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256}, TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, true},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			serverConfig := testConfigServer.Clone()
+			serverConfig.Certificates = tt.certs
+			serverConfig.MaxVersion = VersionTLS12
+			clientConfig := testConfigClient.Clone()
+			clientConfig.CipherSuites = tt.suites
+			clientConfig.InsecureSkipVerify = true
+			_, cs, err := testHandshake(t, clientConfig, serverConfig)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cs.CipherSuite != tt.wantSuite {
+				t.Errorf("cipher suite = %v, want %v", CipherSuiteName(cs.CipherSuite), CipherSuiteName(tt.wantSuite))
+			}
+			leaf := cs.PeerCertificates[0]
+			opaque := leaf.Issuer.CommonName == "test.golang.example CA"
+			if opaque != tt.wantOpaque {
+				t.Errorf("server sent the certificate issued by %q; want the opaque one: %v", leaf.Issuer.CommonName, tt.wantOpaque)
+			}
+			if opaque {
+				if _, err := leaf.Verify(x509.VerifyOptions{Roots: pool, CurrentTime: testTime()}); err != nil {
+					t.Error(err)
+				}
+			}
+		})
+	}
+}
